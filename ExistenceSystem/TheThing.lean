/-! ## The One Piece

`K = ℚ(√−5)`, `δ² = −5`. -/

/-- The polynomial `X² + 5`. Report §1: the defining polynomial of `ℚ(√−5)`. -/
def poly : ℚ[X] := X ^ 2 + C 5

lemma poly_monic : poly.Monic := monic_X_pow_add_C 5 (by decide)

lemma poly_natDegree : poly.natDegree = 2 := by
  simp [poly, natDegree_X_pow_add_C]

lemma poly_ne_zero : poly ≠ 0 := poly_monic.ne_zero

/-- `X² + 5` is irreducible over `ℚ`: a square in `ℚ` is nonnegative, and `−5` is not. -/
lemma poly_irreducible : Irreducible poly := by
  refine irreducible_of_degree_le_three_of_not_isRoot ?_ ?_
  · simp [poly, natDegree_X_pow_add_C, Finset.mem_Icc]
  · intro r hr
    have hr' : r ^ 2 + 5 = 0 := by
      simpa [poly, IsRoot.def, eval_add, eval_pow, eval_X, eval_C] using hr
    have : (0 : ℚ) ≤ -5 := by linarith [sq_nonneg r, hr']
    norm_num at this

instance : Fact (Irreducible poly) := ⟨poly_irreducible⟩

/-- `K = ℚ(√−5)`, as `ℚ[X] / (X² + 5)`. -/
abbrev K : Type := AdjoinRoot poly

/-- `δ = √−5`, the adjoined root. Report §1: "let `δ = √−5`, so `δ² = −5`". -/
def δ : K := AdjoinRoot.root poly

/-- Report §1: `δ² = −5`. -/
lemma delta_sq : δ ^ 2 = -5 := by
  have h0 : AdjoinRoot.mk poly (X ^ 2 + C (5 : ℚ)) = 0 := by
    unfold poly
    simpa using (AdjoinRoot.mk_self (X ^ 2 + C (5 : ℚ)))
  have h1 : AdjoinRoot.mk poly (X ^ 2 + C (5 : ℚ)) =
      (AdjoinRoot.mk poly X) ^ 2 + AdjoinRoot.mk poly (C (5 : ℚ)) := by
    simp [map_add, map_pow]
  rw [h1, AdjoinRoot.mk_X, AdjoinRoot.mk_C] at h0
  simpa [δ, map_ofNat] using eq_neg_of_add_eq_zero_left h0

lemma delta_isIntegral : IsIntegral ℤ δ := by
  refine ⟨X ^ 2 + C 5, monic_X_pow_add_C 5 (by decide), ?_⟩
  simp [aeval_def, eval₂_add, eval₂_pow, eval₂_X, eval₂_C, delta_sq]

/-- The conjugate automorphism `δ ↦ −δ`. -/
noncomputable def conj : K →ₐ[ℚ] K :=
  AdjoinRoot.liftAlgHom poly (Algebra.ofId ℚ K) (-δ) <| by
    have hδ : δ ^ 2 = -5 := delta_sq
    simp [poly, eval₂_add, eval₂_pow, eval₂_X, eval₂_C, map_ofNat, hδ]

@[simp] lemma conj_δ : conj δ = -δ := by
  unfold conj
  exact AdjoinRoot.liftAlgHom_root poly (Algebra.ofId ℚ K) (-δ) _

lemma conj_rat (a : ℚ) : conj (algebraMap ℚ K a) = algebraMap ℚ K a :=
  conj.commutes a

/-! ## Coordinates on the power basis `{1, δ}` -/

noncomputable def pb₀ : PowerBasis ℚ K := AdjoinRoot.powerBasis poly_ne_zero

lemma pb₀_dim : pb₀.dim = 2 := by
  simp [pb₀, AdjoinRoot.powerBasis_dim, poly_natDegree]

/-- Power basis indexed by `Fin 2`, so `basis 0 = 1` and `basis 1 = δ`. -/
noncomputable def pb : PowerBasis ℚ K where
  gen := δ
  dim := 2
  basis := pb₀.basis.reindex (finCongr pb₀_dim)
  basis_eq_pow i := by
    rw [Basis.reindex_apply, PowerBasis.coe_basis]
    dsimp
    simp [pb₀, δ]

@[simp] lemma pb_dim : pb.dim = 2 := rfl

@[simp] lemma pb_gen : pb.gen = δ := rfl

/-- `pb.basis` on the literal index type `Fin 2`. -/
noncomputable def b2 : Basis (Fin 2) ℚ K := pb.basis

lemma pb_basis_zero : b2 0 = 1 :=
  (pb.basis_eq_pow (0 : Fin 2)).trans (pow_zero _)

lemma pb_basis_one : b2 1 = δ :=
  (pb.basis_eq_pow (1 : Fin 2)).trans ((pow_one _).trans pb_gen)

/-- Rational coordinate of `1` in `x = a + b δ`. -/
noncomputable def ratA (x : K) : ℚ := b2.repr x 0

/-- Rational coordinate of `δ` in `x = a + b δ`. -/
noncomputable def ratB (x : K) : ℚ := b2.repr x 1

lemma expand (x : K) : x = algebraMap ℚ K (ratA x) + algebraMap ℚ K (ratB x) * δ := by
  have h := b2.sum_repr x
  rw [Fin.sum_univ_two] at h
  simp only [ratA, ratB, pb_basis_zero, pb_basis_one, Algebra.smul_def, mul_one] at h
  exact h.symm

lemma ratA_add (x y : K) : ratA (x + y) = ratA x + ratA y := by simp [ratA]
lemma ratB_add (x y : K) : ratB (x + y) = ratB x + ratB y := by simp [ratB]
lemma ratA_smul (c : ℚ) (x : K) : ratA (c • x) = c * ratA x := by simp [ratA]
lemma ratB_smul (c : ℚ) (x : K) : ratB (c • x) = c * ratB x := by simp [ratB]

lemma ratAB_coord (a b : ℚ) :
    ratA (algebraMap ℚ K a + algebraMap ℚ K b * δ) = a ∧
      ratB (algebraMap ℚ K a + algebraMap ℚ K b * δ) = b := by
  have hx : algebraMap ℚ K a + algebraMap ℚ K b * δ =
      a • b2 0 + b • b2 1 := by
    simp [pb_basis_zero, pb_basis_one, Algebra.smul_def]
  constructor
  · rw [hx]
    simp [ratA, map_add, map_smul, Basis.repr_self, Finsupp.single_eq_same, Finsupp.single_eq_of_ne]
  · rw [hx]
    simp [ratB, map_add, map_smul, Basis.repr_self, Finsupp.single_eq_same, Finsupp.single_eq_of_ne]

lemma coord_unique {a b a' b' : ℚ}
    (h : algebraMap ℚ K a + algebraMap ℚ K b * δ =
      algebraMap ℚ K a' + algebraMap ℚ K b' * δ) :
    a = a' ∧ b = b' := by
  have h1 := (ratAB_coord a b).1
  have h2 := (ratAB_coord a b).2
  have h1' := (ratAB_coord a' b').1
  have h2' := (ratAB_coord a' b').2
  rw [h] at h1 h2
  exact ⟨h1.symm.trans h1', h2.symm.trans h2'⟩

lemma conj_coord (a b : ℚ) :
    conj (algebraMap ℚ K a + algebraMap ℚ K b * δ) =
      algebraMap ℚ K a - algebraMap ℚ K b * δ := by
  simp [map_add, map_mul, conj_rat, conj_δ, sub_eq_add_neg, neg_mul]

lemma mul_conj_coord (a b : ℚ) :
    (algebraMap ℚ K a + algebraMap ℚ K b * δ) *
        (algebraMap ℚ K a - algebraMap ℚ K b * δ) =
      algebraMap ℚ K (a ^ 2 + 5 * b ^ 2) := by
  rw [sub_eq_add_neg]
  ring_nf
  simp [delta_sq, map_add, map_mul, map_pow, map_ofNat]

/-- Report §1: `N(a + bδ) = a² + 5b²`. -/
lemma fieldNorm_coord (a b : ℚ) :
    Algebra.norm ℚ (algebraMap ℚ K a + algebraMap ℚ K b * δ) = a ^ 2 + 5 * b ^ 2 := by
  classical
  set x : K := algebraMap ℚ K a + algebraMap ℚ K b * δ
  rw [Algebra.norm_eq_matrix_det b2, Matrix.det_fin_two]
  have hx : x = a • b2 0 + b • b2 1 := by
    simp [x, pb_basis_zero, pb_basis_one, Algebra.smul_def, mul_one]
  have h0 : x * b2 0 = a • b2 0 + b • b2 1 := by
    rw [pb_basis_zero, mul_one, hx, pb_basis_zero]
  have h1 : x * b2 1 = (-5 * b) • b2 0 + a • b2 1 := by
    rw [pb_basis_one]
    have hxδ : x * δ = algebraMap ℚ K (-5 * b) + algebraMap ℚ K a * δ := by
      simp only [x]
      calc
        (algebraMap ℚ K a + algebraMap ℚ K b * δ) * δ
            = algebraMap ℚ K a * δ + algebraMap ℚ K b * (δ * δ) := by ring
        _ = algebraMap ℚ K a * δ + algebraMap ℚ K b * (-5) := by rw [← pow_two, delta_sq]
        _ = algebraMap ℚ K (-5 * b) + algebraMap ℚ K a * δ := by
            simp [map_mul, map_neg, map_ofNat, mul_comm]
            ring
    rw [hxδ]
    simp [pb_basis_zero, pb_basis_one, Algebra.smul_def, mul_one]
  have repr0 (c0 c1 : ℚ) : b2.repr (c0 • b2 0 + c1 • b2 1) 0 = c0 := by
    simp [map_add, map_smul, Basis.repr_self_apply, smul_eq_mul]
  have repr1 (c0 c1 : ℚ) : b2.repr (c0 • b2 0 + c1 • b2 1) 1 = c1 := by
    simp [map_add, map_smul, Basis.repr_self_apply, smul_eq_mul]
  have h00 : Algebra.leftMulMatrix b2 x 0 0 = a := by
    rw [Algebra.leftMulMatrix_eq_repr_mul, h0, repr0]
  have h11 : Algebra.leftMulMatrix b2 x 1 1 = a := by
    rw [Algebra.leftMulMatrix_eq_repr_mul, h1, repr1]
  have h10 : Algebra.leftMulMatrix b2 x 1 0 = b := by
    rw [Algebra.leftMulMatrix_eq_repr_mul, h0, repr1]
  have h01 : Algebra.leftMulMatrix b2 x 0 1 = -5 * b := by
    rw [Algebra.leftMulMatrix_eq_repr_mul, h1, repr0]
  rw [h00, h11, h10, h01]
  ring

lemma finrank_K : finrank ℚ K = 2 := by
  simpa [pb] using pb.finrank

/-! ## A rational whose square, times 5, is an integer, is an integer -/

lemma rat_of_five_sq_int {t : ℚ} {m : ℤ} (h : 5 * t ^ 2 = (m : ℚ)) :
    ∃ y : ℤ, (y : ℚ) = t := by
  have hden_pos : 0 < t.den := t.den_pos
  rw [← Rat.num_div_den t] at h
  have hz : (5 : ℤ) * t.num ^ 2 = (t.den : ℤ) ^ 2 * m := by
    have hden0 : (t.den : ℚ) ≠ 0 := by exact_mod_cast hden_pos.ne'
    apply_fun (fun q : ℚ => q * (t.den : ℚ) ^ 2) at h
    field_simp at h
    exact_mod_cast h
  have hcop : IsCoprime ((t.den : ℤ) ^ 2) (t.num ^ 2) := by
    have hc : IsCoprime (t.den : ℤ) t.num :=
      Int.isCoprime_iff_nat_coprime.mpr (by simpa [Int.natAbs_natCast] using t.reduced.symm)
    exact hc.pow
  have hdvd : (t.den : ℤ) ^ 2 ∣ (5 : ℤ) := by
    refine hcop.dvd_of_dvd_mul_left ⟨m, ?_⟩
    calc
      t.num ^ 2 * 5 = 5 * t.num ^ 2 := by ring
      _ = (t.den : ℤ) ^ 2 * m := hz
  have hdvd_nat : t.den ^ 2 ∣ 5 := by exact_mod_cast hdvd
  have hle : t.den ^ 2 ≤ 5 := Nat.le_of_dvd (by decide) hdvd_nat
  have hden_le : t.den ≤ 2 := by
    by_contra hlt
    have : 3 ≤ t.den := by omega
    nlinarith
  have hden : t.den = 1 := by
    interval_cases t.den
    · rfl
    · exfalso
      have h4 : 4 ∣ 5 := by simpa using hdvd_nat
      have : ¬ (4 ∣ 5) := by decide
      exact this h4
  refine ⟨t.num, ?_⟩
  rw [← Rat.num_div_den t, hden]
  norm_num

lemma even_of_sq_sum_mod_four {X Y N : ℤ} (h : X ^ 2 + 5 * Y ^ 2 = 4 * N) :
    (∃ a : ℤ, X = 2 * a) ∧ (∃ b : ℤ, Y = 2 * b) := by
  have hsum : X ^ 2 + Y ^ 2 = 4 * (N - Y ^ 2) := by
    linear_combination h - 4 * Y ^ 2
  have hmod : (X ^ 2 + Y ^ 2) % 4 = 0 := by
    rw [hsum]
    omega
  have hx : ∃ a : ℤ, X = 2 * a := by
    rcases X.even_or_odd' with ⟨k, hk | hk⟩
    · exact ⟨k, hk⟩
    · rcases Y.even_or_odd' with ⟨m, hm | hm⟩
      · have h1 : (X ^ 2 + Y ^ 2) % 4 = 1 := by
          have hxsq : X ^ 2 = 4 * (k * (k + 1)) + 1 := by
            rw [hk]; ring
          have hysq : Y ^ 2 = 4 * m ^ 2 := by
            rw [hm]; ring
          rw [hxsq, hysq]
          omega
        omega
      · have h2 : (X ^ 2 + Y ^ 2) % 4 = 2 := by
          have hxsq : X ^ 2 = 4 * (k * (k + 1)) + 1 := by
            rw [hk]; ring
          have hysq : Y ^ 2 = 4 * (m * (m + 1)) + 1 := by
            rw [hm]; ring
          rw [hxsq, hysq]
          omega
        omega
  have hy : ∃ b : ℤ, Y = 2 * b := by
    rcases Y.even_or_odd' with ⟨m, hm | hm⟩
    · exact ⟨m, hm⟩
    · rcases X.even_or_odd' with ⟨k, hk | hk⟩
      · have h1 : (X ^ 2 + Y ^ 2) % 4 = 1 := by
          have hxsq : X ^ 2 = 4 * k ^ 2 := by
            rw [hk]; ring
          have hysq : Y ^ 2 = 4 * (m * (m + 1)) + 1 := by
            rw [hm]; ring
          rw [hxsq, hysq]
          omega
        omega
      · have h2 : (X ^ 2 + Y ^ 2) % 4 = 2 := by
          have hxsq : X ^ 2 = 4 * (k * (k + 1)) + 1 := by
            rw [hk]; ring
          have hysq : Y ^ 2 = 4 * (m * (m + 1)) + 1 := by
            rw [hm]; ring
          rw [hxsq, hysq]
          omega
        omega
  exact ⟨hx, hy⟩

/-! ## The ring of integers is `ℤ[δ]` -/

lemma isIntegral_coord {x : K} (hx : IsIntegral ℤ x) :
    ∃ a b : ℤ, ratA x = a ∧ ratB x = b := by
  set a : ℚ := ratA x
  set b : ℚ := ratB x
  have hxab : x = algebraMap ℚ K a + algebraMap ℚ K b * δ := expand x
  have hx' : IsIntegral ℤ (conj x) := map_isIntegral_int conj hx
  have hsum : IsIntegral ℤ (x + conj x) := hx.add hx'
  have hprod : IsIntegral ℤ (x * conj x) := hx.mul hx'
  have hconj : conj x = algebraMap ℚ K a - algebraMap ℚ K b * δ := by
    rw [hxab]
    exact conj_coord a b
  have hsumK : x + conj x = algebraMap ℚ K (2 * a) := by
    rw [hxab, conj_coord a b]
    simp [map_add, map_mul, two_mul, sub_eq_add_neg]
    ring
  have hprodK : x * conj x = algebraMap ℚ K (a ^ 2 + 5 * b ^ 2) := by
    rw [hxab, conj_coord a b]
    exact mul_conj_coord a b
  have h2a : IsIntegral ℤ (2 * a : ℚ) := by
    rw [← isIntegral_algebraMap_iff (A := ℚ) (B := K)]
    exact hsumK ▸ hsum
  have hN : IsIntegral ℤ (a ^ 2 + 5 * b ^ 2 : ℚ) := by
    rw [← isIntegral_algebraMap_iff (A := ℚ) (B := K)]
    exact hprodK ▸ hprod
  obtain ⟨X, hX⟩ := IsIntegrallyClosed.isIntegral_iff.mp h2a
  obtain ⟨N, hNq⟩ := IsIntegrallyClosed.isIntegral_iff.mp hN
  -- `X = 2a`, `N = a² + 5b²` in `ℚ`
  have hXq : (X : ℚ) = 2 * a := by
    simpa using hX
  have hNrat : (N : ℚ) = a ^ 2 + 5 * b ^ 2 := by
    simpa using hNq
  -- `5 (2b)² = 4N − X²`
  have hfive : 5 * (2 * b) ^ 2 = (4 * N - X ^ 2 : ℤ) := by
    have hring : 5 * (2 * b) ^ 2 = 4 * (a ^ 2 + 5 * b ^ 2) - (2 * a) ^ 2 := by ring
    rw [hring, ← hNrat, ← hXq]
    push_cast
    ring
  obtain ⟨Y, hY⟩ := rat_of_five_sq_int hfive
  -- `X` and `Y = 2b` are even
  have hXY : X ^ 2 + 5 * Y ^ 2 = 4 * N := by
    have hYq : (Y : ℚ) = 2 * b := hY
    have hcast : (Int.cast (X ^ 2 + 5 * Y ^ 2) : ℚ) = Int.cast (4 * N) := by
      push_cast
      rw [hXq, hYq, hNrat]
      ring
    exact Rat.intCast_injective hcast
  obtain ⟨hXe, hYe⟩ := even_of_sq_sum_mod_four hXY
  obtain ⟨aZ, haZ⟩ := hXe
  obtain ⟨bZ, hbZ⟩ := hYe
  -- `a = aZ`, `b = bZ`
  have ha : a = aZ := by
    have : (X : ℚ) = 2 * (aZ : ℚ) := by exact_mod_cast haZ
    linarith [hXq]
  have hb : b = bZ := by
    have hYq : (Y : ℚ) = 2 * b := hY
    have : (Y : ℚ) = 2 * (bZ : ℚ) := by exact_mod_cast hbZ
    linarith
  exact ⟨aZ, bZ, ha, hb⟩

/-- `δ` as an algebraic integer. -/
noncomputable def δO : 𝓞 K := ⟨δ, delta_isIntegral⟩

@[simp] lemma coe_δO : (δO : K) = δ := rfl

@[simp] lemma δO_sq : δO ^ 2 = -5 := by
  apply RingOfIntegers.ext
  simp only [RingOfIntegers.coe_eq_algebraMap, map_pow, coe_δO, delta_sq, map_neg, map_ofNat]

lemma pair_isIntegral (a b : ℤ) :
    IsIntegral ℤ (algebraMap ℤ K a + algebraMap ℤ K b * δ) := by
  apply IsIntegral.add
  · exact isIntegral_algebraMap
  · exact isIntegral_algebraMap.mul delta_isIntegral

/-- The element `a + b δ` of `𝒪_K`. -/
noncomputable def pairO (a b : ℤ) : 𝓞 K :=
  ⟨algebraMap ℤ K a + algebraMap ℤ K b * δ, pair_isIntegral a b⟩

@[simp] lemma coe_pairO (a b : ℤ) :
    (pairO a b : K) = algebraMap ℤ K a + algebraMap ℤ K b * δ := rfl

lemma coe_pairO_rat (a b : ℤ) :
    (pairO a b : K) = algebraMap ℚ K (a : ℚ) + algebraMap ℚ K (b : ℚ) * δ := by
  simp [map_intCast]

/-- Integer coordinate of `1`. -/
noncomputable def intA (x : 𝓞 K) : ℤ :=
  Classical.choose (isIntegral_coord x.property)

/-- Integer coordinate of `δ`. -/
noncomputable def intB (x : 𝓞 K) : ℤ :=
  Classical.choose (Classical.choose_spec (isIntegral_coord x.property))

lemma intAB_spec (x : 𝓞 K) : ratA (x : K) = intA x ∧ ratB (x : K) = intB x :=
  Classical.choose_spec (Classical.choose_spec (isIntegral_coord x.property))

lemma expand_int (x : 𝓞 K) :
    (x : K) = algebraMap ℤ K (intA x) + algebraMap ℤ K (intB x) * δ := by
  have h := expand (x : K)
  rw [(intAB_spec x).1, (intAB_spec x).2] at h
  simpa [map_intCast] using h

lemma intA_pair (a b : ℤ) : intA (pairO a b) = a := by
  have h := (intAB_spec (pairO a b)).1
  have hc := (ratAB_coord (a : ℚ) (b : ℚ)).1
  rw [← coe_pairO_rat] at hc
  exact Rat.intCast_injective (h.symm.trans hc)

lemma intB_pair (a b : ℤ) : intB (pairO a b) = b := by
  have h := (intAB_spec (pairO a b)).2
  have hc := (ratAB_coord (a : ℚ) (b : ℚ)).2
  rw [← coe_pairO_rat] at hc
  exact Rat.intCast_injective (h.symm.trans hc)

/-- Every algebraic integer is uniquely `a + bδ` with `a, b ∈ ℤ`. Report §1:
the ring of integers is `ℤ[δ]`, and `{1, δ}` is an integral basis. -/
theorem int_coord_unique (x : 𝓞 K) :
    ∃! p : ℤ × ℤ, (x : K) = algebraMap ℤ K p.1 + algebraMap ℤ K p.2 * δ := by
  refine ⟨(intA x, intB x), expand_int x, ?_⟩
  intro ⟨a, b⟩ hab
  have ha : ratA (x : K) = (a : ℚ) := by
    have := (ratAB_coord (a : ℚ) (b : ℚ)).1
    simpa [hab, map_intCast] using this
  have hb : ratB (x : K) = (b : ℚ) := by
    have := (ratAB_coord (a : ℚ) (b : ℚ)).2
    simpa [hab, map_intCast] using this
  exact Prod.ext
    (Rat.intCast_injective (ha.symm.trans (intAB_spec x).1))
    (Rat.intCast_injective (hb.symm.trans (intAB_spec x).2))

lemma intA_add (x y : 𝓞 K) : intA (x + y) = intA x + intA y := by
  apply Rat.intCast_injective
  calc
    (intA (x + y) : ℚ) = ratA (x + y : K) := (intAB_spec _).1.symm
    _ = ratA (x : K) + ratA (y : K) := ratA_add _ _
    _ = (intA x : ℚ) + (intA y : ℚ) := by rw [(intAB_spec x).1, (intAB_spec y).1]
    _ = ((intA x + intA y : ℤ) : ℚ) := (Int.cast_add (intA x) (intA y)).symm

lemma intB_add (x y : 𝓞 K) : intB (x + y) = intB x + intB y := by
  apply Rat.intCast_injective
  calc
    (intB (x + y) : ℚ) = ratB (x + y : K) := (intAB_spec _).2.symm
    _ = ratB (x : K) + ratB (y : K) := ratB_add _ _
    _ = (intB x : ℚ) + (intB y : ℚ) := by rw [(intAB_spec x).2, (intAB_spec y).2]
    _ = ((intB x + intB y : ℤ) : ℚ) := (Int.cast_add (intB x) (intB y)).symm

lemma intA_zsmul (n : ℤ) (x : 𝓞 K) : intA (n • x) = n * intA x := by
  apply Rat.intCast_injective
  have hcoe : algebraMap (𝓞 K) K (n • x) = (n : ℚ) • (x : K) := by
    rw [map_zsmul, zsmul_eq_mul, Algebra.smul_def]
    congr 1
  calc
    (intA (n • x) : ℚ) = ratA (algebraMap (𝓞 K) K (n • x)) := (intAB_spec _).1.symm
    _ = ratA ((n : ℚ) • (x : K)) := by rw [hcoe]
    _ = (n : ℚ) * ratA (x : K) := ratA_smul _ _
    _ = (n : ℚ) * intA x := by rw [(intAB_spec x).1]
    _ = ((n * intA x : ℤ) : ℚ) := (Int.cast_mul n (intA x)).symm

lemma intB_zsmul (n : ℤ) (x : 𝓞 K) : intB (n • x) = n * intB x := by
  apply Rat.intCast_injective
  have hcoe : algebraMap (𝓞 K) K (n • x) = (n : ℚ) • (x : K) := by
    rw [map_zsmul, zsmul_eq_mul, Algebra.smul_def]
    congr 1
  calc
    (intB (n • x) : ℚ) = ratB (algebraMap (𝓞 K) K (n • x)) := (intAB_spec _).2.symm
    _ = ratB ((n : ℚ) • (x : K)) := by rw [hcoe]
    _ = (n : ℚ) * ratB (x : K) := ratB_smul _ _
    _ = (n : ℚ) * intB x := by rw [(intAB_spec x).2]
    _ = ((n * intB x : ℤ) : ℚ) := (Int.cast_mul n (intB x)).symm

/-- `𝒪_K ≃ ℤ²` on the basis `{1, δ}`. -/
noncomputable def coordEquiv : 𝓞 K ≃ₗ[ℤ] (Fin 2 → ℤ) where
  toFun x i := if i = 0 then intA x else intB x
  invFun v := pairO (v 0) (v 1)
  left_inv x := by
    apply RingOfIntegers.ext
    rw [coe_pairO]
    dsimp
    simp [reduceIte]
    exact (expand_int x).symm
  right_inv v := by
    ext i
    fin_cases i
    · simp [intA_pair, if_pos (by rfl : (0 : Fin 2) = 0)]
    · simp [intB_pair, if_neg (by decide : (1 : Fin 2) ≠ 0)]
  map_add' x y := by
    ext i
    fin_cases i
    · simp [intA_add, if_pos (by rfl : (0 : Fin 2) = 0)]
    · simp [intB_add, if_neg (by decide : (1 : Fin 2) ≠ 0)]
  map_smul' n x := by
    ext i
    by_cases hi : i = 0
    · rw [hi]
      simpa [zsmul_eq_mul] using intA_zsmul n x
    · have h1 : i = 1 := by
        apply Fin.ext
        have hlt : i.val < 2 := i.isLt
        have hne : i.val ≠ 0 := fun hv => hi (Fin.ext hv)
        omega
      rw [h1]
      simpa [zsmul_eq_mul] using intB_zsmul n x

/-- Integral basis `{1, δ}`. -/
noncomputable def intBasis : Basis (Fin 2) ℤ (𝓞 K) :=
  Basis.ofEquivFun coordEquiv

lemma intBasis_zero : intBasis 0 = 1 := by
  apply RingOfIntegers.ext
  simp [intBasis, Basis.coe_ofEquivFun, coordEquiv, coe_pairO, Pi.single_eq_same,
    Pi.single_eq_of_ne, map_one, map_zero, mul_zero, add_zero, reduceIte]

lemma intBasis_one : intBasis 1 = δO := by
  apply RingOfIntegers.ext
  simp [intBasis, Basis.coe_ofEquivFun, coordEquiv, coe_pairO, coe_δO, Pi.single_eq_same,
    Pi.single_eq_of_ne, map_one, map_zero, mul_zero, add_zero, reduceIte]

/-- Report §1: the field discriminant is `Δ_K = −20`. -/
theorem discr_eq_neg_twenty : discr K = -20 := by
  classical
  have hsep : Algebra.IsSeparable ℚ K := inferInstance
  have hpb : Algebra.discr ℚ pb₀.basis = -20 := by
    rw [Algebra.discr_powerBasis_eq_norm (K := ℚ) (pb := pb₀)]
    have hmin : minpoly ℚ pb₀.gen = poly :=
      AdjoinRoot.minpoly_powerBasis_gen_of_monic poly_monic
    have hder : (minpoly ℚ pb₀.gen).derivative = C (2 : ℚ) * X := by
      rw [hmin, poly, derivative_add, derivative_X_pow, derivative_C, pow_one, add_zero]
      simp
    have ha : aeval pb₀.gen (minpoly ℚ pb₀.gen).derivative =
        algebraMap ℚ K 2 * pb₀.gen := by
      rw [hder]
      simp [aeval_mul, aeval_X, aeval_C]
    rw [ha, map_mul (Algebra.norm ℚ), finrank_K]
    have h2 : Algebra.norm ℚ (algebraMap ℚ K (2 : ℚ)) = 4 := by
      rw [Algebra.norm_algebraMap, finrank_K]
      norm_num
    have hδ : Algebra.norm ℚ pb₀.gen = 5 := by
      have hgen := Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb₀
      rw [hgen, pb₀_dim, hmin]
      simp [poly, coeff_add, coeff_X_pow, coeff_C]
    rw [h2, hδ]
    norm_num
  have hloc :=
    Algebra.discr_localizationLocalization (R := ℤ) (Rₘ := ℚ) (M := nonZeroDivisors ℤ)
      (Sₘ := K) (b := intBasis)
  have hfun : (intBasis.localizationLocalization ℚ (nonZeroDivisors ℤ) K : Fin 2 → K) =
      (b2 : Fin 2 → K) := by
    ext i
    fin_cases i <;>
      simp [Basis.localizationLocalization_apply, intBasis_zero, intBasis_one, pb_basis_zero,
        pb_basis_one, coe_δO, map_one]
  have hre : Algebra.discr ℚ (b2 : Fin 2 → K) = Algebra.discr ℚ pb₀.basis := by
    have hcomp : (b2 : Fin 2 → K) = pb₀.basis ∘ ⇑(finCongr pb₀_dim).symm := by
      ext i
      simp [b2, pb, Basis.coe_reindex]
    rw [hcomp, Algebra.discr_reindex]
  have hdiscQ :
      Algebra.discr ℚ (intBasis.localizationLocalization ℚ (nonZeroDivisors ℤ) K) = -20 := by
    rw [hfun, hre, hpb]
  have hZ : (Algebra.discr ℤ intBasis : ℚ) = -20 := by
    rw [hloc] at hdiscQ
    exact hdiscQ
  have hbasis : Algebra.discr ℤ intBasis = discr K := discr_eq_discr K intBasis
  apply (Int.cast_injective (α := ℚ))
  rw [← hbasis]
  exact hZ

/-- Report §1: `N(a + bδ) = a² + 5b²` on the ring of integers. -/
theorem intNorm_pair (a b : ℤ) :
    Algebra.norm ℤ (pairO a b) = a ^ 2 + 5 * b ^ 2 := by
  apply (Int.cast_injective (α := ℚ))
  rw [Algebra.coe_norm_int]
  simpa [coe_pairO_rat] using fieldNorm_coord (a : ℚ) (b : ℚ)

lemma coe_eq_pair (x : 𝓞 K) : x = pairO (intA x) (intB x) := by
  apply Subtype.ext
  exact (expand_int x).trans (coe_pairO (intA x) (intB x)).symm

lemma norm_nonneg (x : 𝓞 K) : 0 ≤ Algebra.norm ℤ x := by
  rw [coe_eq_pair x, intNorm_pair]
  nlinarith [sq_nonneg (intA x), sq_nonneg (intB x)]

lemma norm_eq_zero_iff (x : 𝓞 K) : Algebra.norm ℤ x = 0 ↔ x = 0 := by
  rw [coe_eq_pair x, intNorm_pair]
  constructor
  · intro h
    have ha : intA x = 0 := by nlinarith [sq_nonneg (intA x), sq_nonneg (intB x)]
    have hb : intB x = 0 := by nlinarith [sq_nonneg (intA x), sq_nonneg (intB x), h]
    apply RingOfIntegers.ext
    rw [coe_pairO, ha, hb, map_zero, zero_mul, add_zero]
    rfl
  · intro h
    have hcoe : algebraMap ℤ K (intA x) + algebraMap ℤ K (intB x) * δ = 0 := by
      have := congrArg (fun z : 𝓞 K => (z : K)) h
      rw [coe_pairO] at this
      simpa [map_zero] using this
    have hz : algebraMap ℚ K (intA x : ℚ) + algebraMap ℚ K (intB x : ℚ) * δ =
        algebraMap ℚ K 0 + algebraMap ℚ K 0 * δ := by
      simpa [map_intCast, map_zero] using hcoe
    obtain ⟨ha, hb⟩ := coord_unique hz
    have ha' : intA x = 0 := Rat.intCast_injective ha
    have hb' : intB x = 0 := Rat.intCast_injective hb
    simp [ha', hb']

/-- Report §1: `N(α) = 1` if and only if `α = ±1`. Those are the only units. -/
theorem isUnit_iff (x : 𝓞 K) : IsUnit x ↔ x = 1 ∨ x = -1 := by
  constructor
  · intro hx
    have hunit : IsUnit (Algebra.norm ℤ x) := hx.map (Algebra.norm ℤ)
    have hpm : Algebra.norm ℤ x = 1 ∨ Algebra.norm ℤ x = -1 :=
      (Int.isUnit_iff.mp hunit)
    have hpos : 0 ≤ Algebra.norm ℤ x := norm_nonneg x
    have h1 : Algebra.norm ℤ x = 1 := by
      rcases hpm with h | h
      · exact h
      · linarith
    have hx' : x = pairO (intA x) (intB x) := coe_eq_pair x
    rw [hx', intNorm_pair] at h1
    have hb : intB x = 0 := by
      by_contra hb
      have hsq : (1 : ℤ) ≤ (intB x) ^ 2 := by
        have : intB x ≠ 0 := hb
        have : 1 ≤ (intB x).natAbs := Nat.one_le_iff_ne_zero.mpr (by simpa [Int.natAbs_eq_zero] using this)
        have : 1 ≤ (intB x).natAbs ^ 2 := by nlinarith
        simpa [Int.natAbs_sq] using (Nat.cast_le (α := ℤ)).mpr this
      nlinarith [sq_nonneg (intA x)]
    have ha : intA x = 1 ∨ intA x = -1 := by
      have : (intA x) ^ 2 = 1 := by simpa [hb] using h1
      exact sq_eq_one_iff.mp this
    rcases ha with ha | ha
    · left
      rw [hx', ha, hb]
      apply RingOfIntegers.ext
      rw [coe_pairO, map_one, map_zero, zero_mul, add_zero]
      exact (map_one (algebraMap (𝓞 K) K)).symm
    · right
      rw [hx', ha, hb]
      apply RingOfIntegers.ext
      rw [coe_pairO, map_neg, map_one, map_zero, zero_mul, add_zero]
      exact (map_neg (algebraMap (𝓞 K) K) 1).symm
  · intro h
    rcases h with rfl | rfl
    · exact isUnit_one
    · exact isUnit_one.neg

/-- There is no element of norm `2`. Report §1: `a² + 5b² = 2` has no integer solution. -/
theorem no_norm_two (a b : ℤ) : a ^ 2 + 5 * b ^ 2 ≠ 2 := by
  intro h
  have hb : b = 0 := by
    by_contra hb
    have hsq : (1 : ℤ) ≤ b ^ 2 := by
      have : 1 ≤ b.natAbs := Nat.one_le_iff_ne_zero.mpr (by simpa [Int.natAbs_eq_zero] using hb)
      have : 1 ≤ b.natAbs ^ 2 := by nlinarith
      simpa [Int.natAbs_sq] using (Nat.cast_le (α := ℤ)).mpr this
    nlinarith [sq_nonneg a]
  have h0 : (0 : ℤ) ^ 2 = 0 := by norm_num
  rw [hb, h0, mul_zero, add_zero] at h
  rcases a.even_or_odd' with ⟨k, hk | hk⟩
  · rw [hk] at h
    have hsq : (2 * k) ^ 2 = 4 * k ^ 2 := by ring
    rw [hsq] at h
    have hdiv : (4 : ℤ) ∣ 2 := ⟨k ^ 2, h.symm⟩
    exact (by decide : ¬ ((4 : ℤ) ∣ 2)) hdiv
  · rw [hk] at h
    have hsq : (2 * k + 1) ^ 2 = 4 * (k * (k + 1)) + 1 := by ring
    rw [hsq] at h
    generalize ht : k * (k + 1) = t at h
    have h4 : 4 * t = 1 := by omega
    exact (by decide : ¬ ((4 : ℤ) ∣ 1)) ⟨t, h4.symm⟩

/-- There is no element of norm `3`. -/
theorem no_norm_three (a b : ℤ) : a ^ 2 + 5 * b ^ 2 ≠ 3 := by
  intro h
  have hb : b = 0 := by
    by_contra hb
    have hsq : (1 : ℤ) ≤ b ^ 2 := by
      have : 1 ≤ b.natAbs := Nat.one_le_iff_ne_zero.mpr (by simpa [Int.natAbs_eq_zero] using hb)
      have : 1 ≤ b.natAbs ^ 2 := by nlinarith
      simpa [Int.natAbs_sq] using (Nat.cast_le (α := ℤ)).mpr this
    nlinarith [sq_nonneg a]
  have h0 : (0 : ℤ) ^ 2 = 0 := by norm_num
  rw [hb, h0, mul_zero, add_zero] at h
  rcases a.even_or_odd' with ⟨k, hk | hk⟩
  · rw [hk] at h
    have hsq : (2 * k) ^ 2 = 4 * k ^ 2 := by ring
    rw [hsq] at h
    have hdiv : (4 : ℤ) ∣ 3 := ⟨k ^ 2, h.symm⟩
    exact (by decide : ¬ ((4 : ℤ) ∣ 3)) hdiv
  · rw [hk] at h
    have hsq : (2 * k + 1) ^ 2 = 4 * (k * (k + 1)) + 1 := by ring
    rw [hsq] at h
    generalize ht : k * (k + 1) = t at h
    have h4 : 4 * t = 2 := by omega
    exact (by decide : ¬ ((4 : ℤ) ∣ 2)) ⟨t, h4.symm⟩

/-! ## Signature `(0, 1)` and the Minkowski bound -/

lemma not_isReal (phi : K →+* ℂ) : ¬ ComplexEmbedding.IsReal phi := by
  intro hphi
  let psi : K →+* ℝ := ComplexEmbedding.IsReal.embedding hphi
  have hpsi : (psi δ) ^ 2 = -5 := by
    have h := congrArg psi delta_sq
    simpa [map_pow, map_neg, map_ofNat] using h
  have hnn : 0 ≤ (psi δ) ^ 2 := sq_nonneg _
  linarith

/-- Report §1, signature `(0, 1)`: there is no real place. -/
theorem nrRealPlaces_eq_zero : nrRealPlaces K = 0 := by
  rw [nrRealPlaces_eq_zero_iff]
  refine ⟨fun w => ?_⟩
  rw [InfinitePlace.isComplex_iff]
  exact not_isReal (InfinitePlace.embedding w)

/-- One complex place. -/
theorem nrComplexPlaces_eq_one : nrComplexPlaces K = 1 := by
  have h := card_add_two_mul_card_eq_rank K
  rw [nrRealPlaces_eq_zero, finrank_K] at h
  omega

/-- The Minkowski bound, written as Mathlib writes `M K`. -/
noncomputable def minkowskiBound : ℝ :=
  (4 / π) ^ nrComplexPlaces K *
    ((finrank ℚ K)! / (finrank ℚ K) ^ (finrank ℚ K) * √|discr K|)

/-- Report §1: `M_K = (4/π) √5 < 3`. -/
theorem minkowskiBound_lt_three : minkowskiBound < 3 := by
  rw [minkowskiBound, nrComplexPlaces_eq_one, finrank_K, discr_eq_neg_twenty, pow_one]
  have hpi : (3.14 : ℝ) < π := Real.pi_gt_d2
  have habs : √|(-20 : ℤ)| = 2 * √(5 : ℝ) := by
    have h20 : |(-20 : ℤ)| = (20 : ℤ) := by simp [abs_neg]
    have hcast : (|(-20 : ℤ)| : ℝ) = 20 := by simp [h20]
    rw [show √|(-20 : ℤ)| = √(|(-20 : ℤ)| : ℝ) from rfl, hcast]
    rw [show (20 : ℝ) = (2 : ℝ) ^ 2 * 5 by norm_num, Real.sqrt_mul (by positivity),
      Real.sqrt_sq (by positivity)]
  rw [Nat.factorial_two, habs]
  have hform : (4 / π) * (((2 : ℕ) : ℝ) / ((2 : ℕ) : ℝ) ^ 2 * (2 * √(5 : ℝ))) =
      (4 / π) * √(5 : ℝ) := by
    field_simp
    norm_num
  rw [hform, div_mul_eq_mul_div, div_lt_iff₀ Real.pi_pos]
  have hleft : 0 ≤ 4 * √(5 : ℝ) := by positivity
  have hright : 0 ≤ 3 * (3.14 : ℝ) := by positivity
  have hsq : (4 * √(5 : ℝ)) ^ 2 < (3 * (3.14 : ℝ)) ^ 2 := by
    have h5 : √(5 : ℝ) ^ 2 = 5 := Real.sq_sqrt (by norm_num)
    nlinarith [h5]
  have hlt : 4 * √(5 : ℝ) < 3 * (3.14 : ℝ) := (sq_lt_sq₀ hleft hright).mp hsq
  have hpi' : 3 * (3.14 : ℝ) < 3 * π := by gcongr
  linarith

/-! ## Ideal factorization

Report §2: `(2) = 𝔭₂²`, `(3) = 𝔭₃ 𝔭₃′`, and
`(6) = 𝔭₂² 𝔭₃ 𝔭₃′ = (1+δ)(1−δ)`.
Unique factorization of elements fails; unique factorization of ideals holds.
-/

lemma eq_one_or_neg_one_of_norm_eq_one {x : 𝓞 K} (h1 : Algebra.norm ℤ x = 1) :
    x = 1 ∨ x = -1 := by
  have hx' : x = pairO (intA x) (intB x) := coe_eq_pair x
  rw [hx', intNorm_pair] at h1
  have hb : intB x = 0 := by
    by_contra hb
    have hsq : (1 : ℤ) ≤ (intB x) ^ 2 := by
      have : intB x ≠ 0 := hb
      have : 1 ≤ (intB x).natAbs :=
        Nat.one_le_iff_ne_zero.mpr (by simpa [Int.natAbs_eq_zero] using this)
      have : 1 ≤ (intB x).natAbs ^ 2 := by nlinarith
      simpa [Int.natAbs_sq] using (Nat.cast_le (α := ℤ)).mpr this
    nlinarith [sq_nonneg (intA x)]
  have ha : intA x = 1 ∨ intA x = -1 := by
    have : (intA x) ^ 2 = 1 := by simpa [hb] using h1
    exact sq_eq_one_iff.mp this
  rcases ha with ha | ha
  · left
    rw [hx', ha, hb]
    apply RingOfIntegers.ext
    rw [coe_pairO, map_one, map_zero, zero_mul, add_zero]
    exact (map_one (algebraMap (𝓞 K) K)).symm
  · right
    rw [hx', ha, hb]
    apply RingOfIntegers.ext
    rw [coe_pairO, map_neg, map_one, map_zero, zero_mul, add_zero]
    exact (map_neg (algebraMap (𝓞 K) K) 1).symm

lemma isUnit_of_norm_eq_one {x : 𝓞 K} (h1 : Algebra.norm ℤ x = 1) : IsUnit x :=
  (isUnit_iff x).mpr (eq_one_or_neg_one_of_norm_eq_one h1)

lemma pairO_two : (2 : 𝓞 K) = pairO 2 0 := by
  apply RingOfIntegers.ext
  rw [coe_pairO, map_ofNat, map_zero, zero_mul, add_zero]
  exact (map_ofNat (algebraMap (𝓞 K) K) 2).symm

lemma pairO_three : (3 : 𝓞 K) = pairO 3 0 := by
  apply RingOfIntegers.ext
  rw [coe_pairO, map_ofNat, map_zero, zero_mul, add_zero]
  exact (map_ofNat (algebraMap (𝓞 K) K) 3).symm

lemma one_add_δO_eq : 1 + δO = pairO 1 1 := by
  apply RingOfIntegers.ext
  rw [coe_pairO]
  simp [coe_δO, map_one, one_mul]

lemma one_sub_δO_eq : 1 - δO = pairO 1 (-1) := by
  apply RingOfIntegers.ext
  rw [coe_pairO, sub_eq_add_neg]
  simp [coe_δO, map_one, map_neg, one_mul]

lemma norm_two : Algebra.norm ℤ (2 : 𝓞 K) = 4 := by
  rw [pairO_two, intNorm_pair]
  norm_num

lemma norm_three : Algebra.norm ℤ (3 : 𝓞 K) = 9 := by
  rw [pairO_three, intNorm_pair]
  norm_num

lemma norm_one_add : Algebra.norm ℤ (1 + δO) = 6 := by
  rw [one_add_δO_eq, intNorm_pair]
  norm_num

lemma norm_one_sub : Algebra.norm ℤ (1 - δO) = 6 := by
  rw [one_sub_δO_eq, intNorm_pair]
  norm_num

/-- `(1+δ)(1−δ) = 6`. -/
lemma mul_conj_δO : (1 + δO) * (1 - δO) = 6 := by
  calc
    (1 + δO) * (1 - δO) = 1 - δO ^ 2 := by ring
    _ = 1 - (-5) := by rw [δO_sq]
    _ = 6 := by ring

/-- Report §1: `(2+2δ) − (−4+2δ) − 4 = 2`. -/
lemma two_lincomb :
    2 * (1 + δO) - (1 + δO) * (1 + δO) - ((2 : 𝓞 K) * 2) = 2 := by
  have hsq : (1 + δO) * (1 + δO) = 2 * δO - 4 := by
    calc
      (1 + δO) * (1 + δO) = 1 + 2 * δO + δO ^ 2 := by ring
      _ = 1 + 2 * δO + (-5) := by rw [δO_sq]
      _ = 2 * δO - 4 := by ring
  rw [hsq]
  ring

/-- Report §2: `9 − 6 = 3`. -/
lemma three_lincomb : (3 : 𝓞 K) * 3 - (1 + δO) * (1 - δO) = 3 := by
  rw [mul_conj_δO]
  ring

/-- The cofactor witnessing `3(1+δ) ∈ (1−δ)`. -/
lemma three_one_add_factor : (1 - δO) * (-2 + δO) = 3 * (1 + δO) := by
  calc
    (1 - δO) * (-2 + δO) = -2 + 3 * δO - δO ^ 2 := by ring
    _ = -2 + 3 * δO - (-5) := by rw [δO_sq]
    _ = 3 * (1 + δO) := by ring

/-- Report §1: `𝔭₂ = (2, 1+δ)`. -/
noncomputable def p₂ : Ideal (𝓞 K) := Ideal.span {(2 : 𝓞 K), 1 + δO}

/-- Report §2: `𝔭₃ = (3, 1+δ)`. -/
noncomputable def p₃ : Ideal (𝓞 K) := Ideal.span {(3 : 𝓞 K), 1 + δO}

/-- Report §2: `𝔭₃′ = (3, 1−δ)`. -/
noncomputable def p₃' : Ideal (𝓞 K) := Ideal.span {(3 : 𝓞 K), 1 - δO}

/-- Report §1: `𝔭₂² = (2)`. -/
theorem p₂_sq : p₂ ^ 2 = Ideal.span {(2 : 𝓞 K)} := by
  unfold p₂
  rw [pow_two, Ideal.span_pair_mul_span_pair]
  apply le_antisymm
  · rw [Ideal.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact Ideal.mem_span_singleton.mpr ⟨2, rfl⟩
    · exact Ideal.mem_span_singleton.mpr ⟨1 + δO, rfl⟩
    · exact Ideal.mem_span_singleton.mpr ⟨1 + δO, mul_comm (1 + δO) 2⟩
    · refine Ideal.mem_span_singleton.mpr ⟨δO - 2, ?_⟩
      calc
        (1 + δO) * (1 + δO) = 1 + 2 * δO + δO ^ 2 := by ring
        _ = 1 + 2 * δO + (-5) := by rw [δO_sq]
        _ = 2 * δO - 4 := by ring
        _ = (2 : 𝓞 K) * (δO - 2) := by ring
  · rw [Ideal.span_singleton_le_iff_mem]
    have h1 : (2 : 𝓞 K) * 2 ∈
        Ideal.span {(2 : 𝓞 K) * 2, 2 * (1 + δO), (1 + δO) * 2, (1 + δO) * (1 + δO)} :=
      Ideal.subset_span (Set.mem_insert _ _)
    have h2 : 2 * (1 + δO) ∈
        Ideal.span {(2 : 𝓞 K) * 2, 2 * (1 + δO), (1 + δO) * 2, (1 + δO) * (1 + δO)} :=
      Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
    have h4 : (1 + δO) * (1 + δO) ∈
        Ideal.span {(2 : 𝓞 K) * 2, 2 * (1 + δO), (1 + δO) * 2, (1 + δO) * (1 + δO)} :=
      Ideal.subset_span
        (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _
          (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
    have hmem := sub_mem (sub_mem h2 h4) h1
    rw [two_lincomb] at hmem
    exact hmem

/-- Report §2: `(3) = 𝔭₃ 𝔭₃′`. -/
theorem p₃_mul_p₃' : p₃ * p₃' = Ideal.span {(3 : 𝓞 K)} := by
  unfold p₃ p₃'
  rw [Ideal.span_pair_mul_span_pair]
  apply le_antisymm
  · rw [Ideal.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact Ideal.mem_span_singleton.mpr ⟨3, rfl⟩
    · exact Ideal.mem_span_singleton.mpr ⟨1 - δO, rfl⟩
    · exact Ideal.mem_span_singleton.mpr ⟨1 + δO, mul_comm (1 + δO) 3⟩
    · refine Ideal.mem_span_singleton.mpr ⟨2, ?_⟩
      rw [mul_conj_δO]
      exact (by ring : (3 : 𝓞 K) * 2 = 6).symm
  · rw [Ideal.span_singleton_le_iff_mem]
    have h9 : (3 : 𝓞 K) * 3 ∈
        Ideal.span {(3 : 𝓞 K) * 3, 3 * (1 - δO), (1 + δO) * 3, (1 + δO) * (1 - δO)} :=
      Ideal.subset_span (Set.mem_insert _ _)
    have h6 : (1 + δO) * (1 - δO) ∈
        Ideal.span {(3 : 𝓞 K) * 3, 3 * (1 - δO), (1 + δO) * 3, (1 + δO) * (1 - δO)} :=
      Ideal.subset_span
        (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _
          (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
    have hmem := sub_mem h9 h6
    rw [three_lincomb] at hmem
    exact hmem

lemma absNorm_span_two : Ideal.absNorm (Ideal.span {(2 : 𝓞 K)}) = 4 := by
  have h := Ideal.absNorm_span_natCast (S := 𝓞 K) 2
  rw [RingOfIntegers.rank, finrank_K] at h
  simpa using h

lemma absNorm_span_three : Ideal.absNorm (Ideal.span {(3 : 𝓞 K)}) = 9 := by
  have h := Ideal.absNorm_span_natCast (S := 𝓞 K) 3
  rw [RingOfIntegers.rank, finrank_K] at h
  simpa using h

lemma absNorm_one_add : Ideal.absNorm (Ideal.span {1 + δO}) = 6 := by
  rw [Ideal.absNorm_span_singleton, norm_one_add]
  decide

lemma absNorm_one_sub : Ideal.absNorm (Ideal.span {1 - δO}) = 6 := by
  rw [Ideal.absNorm_span_singleton, norm_one_sub]
  decide

lemma absNorm_p₂ : Ideal.absNorm p₂ = 2 := by
  have h := congrArg Ideal.absNorm p₂_sq
  rw [pow_two, map_mul Ideal.absNorm, absNorm_span_two] at h
  have hsq : Ideal.absNorm p₂ * Ideal.absNorm p₂ = 4 := h
  match h0 : Ideal.absNorm p₂ with
  | 0 =>
      rw [h0] at hsq
      exact absurd hsq (by decide : (0 : ℕ) ≠ 4)
  | 1 =>
      rw [h0] at hsq
      exact absurd hsq (by decide : (1 : ℕ) ≠ 4)
  | 2 => rfl
  | n + 3 =>
      have hlt : 9 ≤ Ideal.absNorm p₂ * Ideal.absNorm p₂ := by
        have h3 : 3 ≤ Ideal.absNorm p₂ := by omega
        nlinarith
      rw [hsq] at hlt
      omega

lemma absNorm_p₃_dvd_three : Ideal.absNorm p₃ ∣ 3 := by
  have h := Ideal.absNorm_span_insert (3 : 𝓞 K) ({1 + δO} : Set (𝓞 K))
  rw [absNorm_one_add] at h
  have h9 : (Algebra.norm ℤ (3 : 𝓞 K)).natAbs = 9 := by
    rw [norm_three]
    decide
  rw [h9] at h
  have hg : Nat.gcd 6 9 = 3 := by decide
  have hp : Ideal.span (insert (3 : 𝓞 K) ({1 + δO} : Set (𝓞 K))) = p₃ := rfl
  rw [hp] at h
  exact hg ▸ h

lemma absNorm_p₃'_dvd_three : Ideal.absNorm p₃' ∣ 3 := by
  have h := Ideal.absNorm_span_insert (3 : 𝓞 K) ({1 - δO} : Set (𝓞 K))
  rw [absNorm_one_sub] at h
  have h9 : (Algebra.norm ℤ (3 : 𝓞 K)).natAbs = 9 := by
    rw [norm_three]
    decide
  rw [h9] at h
  have hg : Nat.gcd 6 9 = 3 := by decide
  have hp : Ideal.span (insert (3 : 𝓞 K) ({1 - δO} : Set (𝓞 K))) = p₃' := rfl
  rw [hp] at h
  exact hg ▸ h

lemma absNorm_p₃ : Ideal.absNorm p₃ = 3 := by
  have hn := absNorm_p₃_dvd_three
  have hn' := absNorm_p₃'_dvd_three
  have hmul : Ideal.absNorm p₃ * Ideal.absNorm p₃' = 9 := by
    have h := congrArg Ideal.absNorm p₃_mul_p₃'
    rwa [map_mul Ideal.absNorm, absNorm_span_three] at h
  rcases (Nat.dvd_prime Nat.prime_three).mp hn with h | h
  · rw [h, one_mul] at hmul
    rw [hmul] at hn'
    exact absurd hn' (by decide : ¬ (9 : ℕ) ∣ 3)
  · exact h

lemma absNorm_p₃' : Ideal.absNorm p₃' = 3 := by
  have hmul : Ideal.absNorm p₃ * Ideal.absNorm p₃' = 9 := by
    have h := congrArg Ideal.absNorm p₃_mul_p₃'
    rwa [map_mul Ideal.absNorm, absNorm_span_three] at h
  rw [absNorm_p₃] at hmul
  omega

/-- Equal norm and an inclusion of nonzero ideals is equality. Report §2. -/
lemma eq_of_le_of_absNorm_eq {I J : Ideal (𝓞 K)} (hJI : J ≤ I)
    (hn : Ideal.absNorm I = Ideal.absNorm J) (hne : Ideal.absNorm I ≠ 0) : I = J := by
  have hfin : I.toAddSubgroup.FiniteIndex :=
    AddSubgroup.finiteIndex_iff.mpr (by
      rw [← Ideal.absNorm_eq_index]
      exact hne)
  have hle : J.toAddSubgroup ≤ I.toAddSubgroup := by
    intro x hx
    exact hJI hx
  have hdvd : J.toAddSubgroup.index ∣ I.toAddSubgroup.index := by
    rw [← Ideal.absNorm_eq_index, ← Ideal.absNorm_eq_index, hn]
  have heq : J.toAddSubgroup = I.toAddSubgroup :=
    AddSubgroup.eq_of_index_dvd_index (hK := hfin) hle hdvd
  exact (Submodule.toAddSubgroup_injective heq).symm

/-- Report §2: `(1+δ) = 𝔭₂ 𝔭₃`. -/
theorem p₂_mul_p₃ : p₂ * p₃ = Ideal.span {1 + δO} := by
  have hle : p₂ * p₃ ≤ Ideal.span {1 + δO} := by
    unfold p₂ p₃
    rw [Ideal.span_pair_mul_span_pair, Ideal.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · refine Ideal.mem_span_singleton.mpr ⟨1 - δO, ?_⟩
      rw [mul_conj_δO]
      exact (by ring : (2 : 𝓞 K) * 3 = 6)
    · exact Ideal.mem_span_singleton.mpr ⟨2, mul_comm 2 (1 + δO)⟩
    · exact Ideal.mem_span_singleton.mpr ⟨3, rfl⟩
    · exact Ideal.mem_span_singleton.mpr ⟨1 + δO, rfl⟩
  have hn : Ideal.absNorm (Ideal.span {1 + δO}) = Ideal.absNorm (p₂ * p₃) := by
    rw [map_mul Ideal.absNorm, absNorm_p₂, absNorm_p₃, absNorm_one_add]
    norm_num
  have hne : Ideal.absNorm (Ideal.span {1 + δO}) ≠ 0 := by
    rw [absNorm_one_add]
    decide
  exact (eq_of_le_of_absNorm_eq hle hn hne).symm

/-- Report §2: `(1−δ) = 𝔭₂ 𝔭₃′`. -/
theorem p₂_mul_p₃' : p₂ * p₃' = Ideal.span {1 - δO} := by
  have hle : p₂ * p₃' ≤ Ideal.span {1 - δO} := by
    unfold p₂ p₃'
    rw [Ideal.span_pair_mul_span_pair, Ideal.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · refine Ideal.mem_span_singleton.mpr ⟨1 + δO, ?_⟩
      rw [mul_comm (1 - δO) (1 + δO), mul_conj_δO]
      exact (by ring : (2 : 𝓞 K) * 3 = 6)
    · exact Ideal.mem_span_singleton.mpr ⟨2, mul_comm 2 (1 - δO)⟩
    · refine Ideal.mem_span_singleton.mpr ⟨-2 + δO, ?_⟩
      rw [three_one_add_factor]
      exact (mul_comm (3 : 𝓞 K) (1 + δO)).symm
    · exact Ideal.mem_span_singleton.mpr ⟨1 + δO, mul_comm (1 + δO) (1 - δO)⟩
  have hn : Ideal.absNorm (Ideal.span {1 - δO}) = Ideal.absNorm (p₂ * p₃') := by
    rw [map_mul Ideal.absNorm, absNorm_p₂, absNorm_p₃', absNorm_one_sub]
    norm_num
  have hne : Ideal.absNorm (Ideal.span {1 - δO}) ≠ 0 := by
    rw [absNorm_one_sub]
    decide
  exact (eq_of_le_of_absNorm_eq hle hn hne).symm

/-- Report §2: `(6) = (2)(3)`. -/
theorem span_six_eq_two_mul_three :
    Ideal.span {(6 : 𝓞 K)} = Ideal.span {(2 : 𝓞 K)} * Ideal.span {(3 : 𝓞 K)} := by
  have h : (2 : 𝓞 K) * 3 = 6 := by ring
  rw [← h, Ideal.span_singleton_mul_span_singleton]

/-- Report §2: `(6) = 𝔭₂² 𝔭₃ 𝔭₃′`. -/
theorem span_six_eq_prime_factors :
    Ideal.span {(6 : 𝓞 K)} = p₂ ^ 2 * p₃ * p₃' := by
  rw [span_six_eq_two_mul_three, ← p₂_sq, ← p₃_mul_p₃']
  exact (mul_assoc (p₂ ^ 2) p₃ p₃').symm

/-- Report §2: `(6) = (1+δ)(1−δ)`. -/
theorem span_six_eq_conj_factors :
    Ideal.span {(6 : 𝓞 K)} = Ideal.span {1 + δO} * Ideal.span {1 - δO} := by
  rw [← p₂_mul_p₃, ← p₂_mul_p₃', span_six_eq_prime_factors, pow_two]
  ac_rfl

/-- Report §2: `6 = 2·3 = (1+δ)(1−δ)`. -/
theorem six_factorizations :
    (6 : 𝓞 K) = 2 * 3 ∧ (6 : 𝓞 K) = (1 + δO) * (1 - δO) := by
  constructor
  · ring
  · exact mul_conj_δO.symm

lemma not_isUnit_of_norm {x : 𝓞 K} {n : ℕ} (hx : Algebra.norm ℤ x = (n : ℤ)) (hn : 1 < n) :
    ¬ IsUnit x := by
  intro h
  have hNu : IsUnit (Algebra.norm ℤ x) := h.map (Algebra.norm ℤ)
  rcases Int.isUnit_iff.mp hNu with h1 | h1
  · rw [hx] at h1
    have : n = 1 := by exact_mod_cast h1
    omega
  · have hpos := norm_nonneg x
    rw [h1] at hpos
    omega

lemma irreducible_of_norm {x : 𝓞 K} {n : ℕ} (hx : Algebra.norm ℤ x = (n : ℤ)) (hn : 1 < n)
    (hno : ∀ d : ℕ, d ∣ n → 1 < d → d < n → ∀ a b : ℤ, a ^ 2 + 5 * b ^ 2 ≠ (d : ℤ)) :
    Irreducible x := by
  refine ⟨not_isUnit_of_norm hx hn, ?_⟩
  intro a b hab
  have hmul : Algebra.norm ℤ a * Algebra.norm ℤ b = (n : ℤ) := by
    rw [← map_mul (Algebra.norm ℤ), ← hab, hx]
  have habs : (Algebra.norm ℤ a).natAbs * (Algebra.norm ℤ b).natAbs = n := by
    have hcast := congrArg Int.natAbs hmul
    simpa [Int.natAbs_mul, Int.natAbs_natCast] using hcast
  set da := (Algebra.norm ℤ a).natAbs
  set db := (Algebra.norm ℤ b).natAbs
  have hdiv : da ∣ n := ⟨db, habs.symm⟩
  have hda_pos : 0 < da := by
    rcases da.eq_zero_or_pos with h0 | hp
    · rw [h0, zero_mul] at habs
      omega
    · exact hp
  by_cases h1 : da = 1
  · left
    have hNa : Algebra.norm ℤ a = 1 := by
      calc
        Algebra.norm ℤ a = |(Algebra.norm ℤ a)| := (abs_of_nonneg (norm_nonneg a)).symm
        _ = ((Algebra.norm ℤ a).natAbs : ℤ) := (Int.natCast_natAbs _).symm
        _ = 1 := by exact_mod_cast h1
    exact isUnit_of_norm_eq_one hNa
  · by_cases hn_eq : da = n
    · right
      have hdb1 : db = 1 :=
        Nat.eq_of_mul_eq_mul_left hda_pos (habs.trans (by
          rw [mul_one]
          exact hn_eq.symm))
      have hNb : Algebra.norm ℤ b = 1 := by
        calc
          Algebra.norm ℤ b = |(Algebra.norm ℤ b)| := (abs_of_nonneg (norm_nonneg b)).symm
          _ = ((Algebra.norm ℤ b).natAbs : ℤ) := (Int.natCast_natAbs _).symm
          _ = 1 := by exact_mod_cast hdb1
      exact isUnit_of_norm_eq_one hNb
    · have hle : da ≤ n := Nat.le_of_dvd (by omega) hdiv
      have hltn : da < n := lt_of_le_of_ne hle hn_eq
      have hlt1 : 1 < da := by
        have htwo : 2 ≤ da := (Nat.two_le_iff da).mpr ⟨ne_of_gt hda_pos, h1⟩
        omega
      have hcoord : (intA a) ^ 2 + 5 * (intB a) ^ 2 = (da : ℤ) := by
        rw [← intNorm_pair, ← coe_eq_pair a]
        calc
          Algebra.norm ℤ a = |(Algebra.norm ℤ a)| := (abs_of_nonneg (norm_nonneg a)).symm
          _ = ((Algebra.norm ℤ a).natAbs : ℤ) := (Int.natCast_natAbs _).symm
          _ = (da : ℤ) := rfl
      exact absurd hcoord (hno da hdiv hlt1 hltn (intA a) (intB a))

/-- Report §2: `2` is irreducible. `a² + 5b² = 2` has no integer solution. -/
theorem irreducible_two : Irreducible (2 : 𝓞 K) := by
  refine irreducible_of_norm norm_two (by decide) ?_
  intro d hd hlt1 hltn a b h
  interval_cases d
  · exact no_norm_two a b h
  · exact absurd hd (by decide : ¬ (3 : ℕ) ∣ 4)

/-- Report §2: `3` is irreducible. `a² + 5b² = 3` has no integer solution. -/
theorem irreducible_three : Irreducible (3 : 𝓞 K) := by
  refine irreducible_of_norm norm_three (by decide) ?_
  intro d hd hlt1 hltn a b h
  interval_cases d
  · exact absurd hd (by decide : ¬ (2 : ℕ) ∣ 9)
  · exact no_norm_three a b h
  · exact absurd hd (by decide : ¬ (4 : ℕ) ∣ 9)
  · exact absurd hd (by decide : ¬ (5 : ℕ) ∣ 9)
  · exact absurd hd (by decide : ¬ (6 : ℕ) ∣ 9)
  · exact absurd hd (by decide : ¬ (7 : ℕ) ∣ 9)
  · exact absurd hd (by decide : ¬ (8 : ℕ) ∣ 9)

/-- Report §2: `1+δ` is irreducible. A factor would have norm `2` or `3`. -/
theorem irreducible_one_add : Irreducible (1 + δO) := by
  refine irreducible_of_norm norm_one_add (by decide) ?_
  intro d hd hlt1 hltn a b h
  interval_cases d
  · exact no_norm_two a b h
  · exact no_norm_three a b h
  · exact absurd hd (by decide : ¬ (4 : ℕ) ∣ 6)
  · exact absurd hd (by decide : ¬ (5 : ℕ) ∣ 6)

/-- Report §2: `1−δ` is irreducible. -/
theorem irreducible_one_sub : Irreducible (1 - δO) := by
  refine irreducible_of_norm norm_one_sub (by decide) ?_
  intro d hd hlt1 hltn a b h
  interval_cases d
  · exact no_norm_two a b h
  · exact no_norm_three a b h
  · exact absurd hd (by decide : ¬ (4 : ℕ) ∣ 6)
  · exact absurd hd (by decide : ¬ (5 : ℕ) ∣ 6)

lemma not_dvd_of_norm {p x : 𝓞 K} {np nx : ℕ}
    (hp : Algebra.norm ℤ p = (np : ℤ)) (hx : Algebra.norm ℤ x = (nx : ℤ))
    (hnd : ¬ np ∣ nx) : ¬ p ∣ x := by
  intro h
  obtain ⟨c, hc⟩ := h
  have hmul : Algebra.norm ℤ x = Algebra.norm ℤ p * Algebra.norm ℤ c := by
    rw [hc, map_mul]
  rw [hp, hx] at hmul
  have : (np : ℤ) ∣ (nx : ℤ) := ⟨Algebra.norm ℤ c, hmul⟩
  exact hnd (Int.natCast_dvd_natCast.mp this)

/-- Report §2: `2` divides `(1+δ)(1−δ)`, and `(1±δ)/2` is not in `ℤ[δ]`. -/
theorem two_not_prime : ¬ Prime (2 : 𝓞 K) := by
  intro hp
  have hdvd : (2 : 𝓞 K) ∣ (1 + δO) * (1 - δO) := by
    rw [mul_conj_δO]
    exact ⟨3, by ring⟩
  rcases hp.dvd_or_dvd hdvd with h | h
  · exact not_dvd_of_norm norm_two norm_one_add (by decide : ¬ (4 : ℕ) ∣ 6) h
  · exact not_dvd_of_norm norm_two norm_one_sub (by decide : ¬ (4 : ℕ) ∣ 6) h

/-- Report §2: unique factorization of elements fails. -/
theorem not_uniqueFactorization_elements : ¬ UniqueFactorizationMonoid (𝓞 K) := by
  intro h
  haveI := h
  exact two_not_prime (UniqueFactorizationMonoid.irreducible_iff_prime.mp irreducible_two)

/-- Report §2: unique factorization of ideals holds, because `𝒪_K` is a Dedekind domain. -/
theorem uniqueFactorization_ideals : UniqueFactorizationMonoid (Ideal (𝓞 K)) :=
  inferInstance

lemma not_associated_of_norm {x y : 𝓞 K} {m n : ℕ}
    (hx : Algebra.norm ℤ x = (m : ℤ)) (hy : Algebra.norm ℤ y = (n : ℤ)) (hne : m ≠ n) :
    ¬ Associated x y := by
  intro h
  obtain ⟨u, hu⟩ := h
  have hmul := congrArg (Algebra.norm ℤ) hu
  rw [map_mul, hx, hy] at hmul
  have huu : IsUnit (u : 𝓞 K) := u.isUnit
  have hNu : Algebra.norm ℤ (u : 𝓞 K) = 1 := by
    rcases Int.isUnit_iff.mp (huu.map (Algebra.norm ℤ)) with h1 | h1
    · exact h1
    · have hpos := norm_nonneg (u : 𝓞 K)
      rw [h1] at hpos
      omega
  rw [hNu, mul_one] at hmul
  exact hne (by exact_mod_cast hmul)

/-- Report §2: the two irreducible factorizations of `6` are distinct up to units. -/
theorem factorizations_not_associated :
    ¬ Associated (2 : 𝓞 K) (3 : 𝓞 K) ∧
    ¬ Associated (2 : 𝓞 K) (1 + δO) ∧
    ¬ Associated (2 : 𝓞 K) (1 - δO) ∧
    ¬ Associated (3 : 𝓞 K) (1 + δO) ∧
    ¬ Associated (3 : 𝓞 K) (1 - δO) ∧
    ¬ Associated (1 + δO) (1 - δO) := by
  refine ⟨not_associated_of_norm norm_two norm_three (by decide),
    not_associated_of_norm norm_two norm_one_add (by decide),
    not_associated_of_norm norm_two norm_one_sub (by decide),
    not_associated_of_norm norm_three norm_one_add (by decide),
    not_associated_of_norm norm_three norm_one_sub (by decide), ?_⟩
  intro h
  obtain ⟨u, hu⟩ := h
  have huu := (isUnit_iff (u : 𝓞 K)).mp u.isUnit
  rcases huu with h1 | h1
  · have heq : 1 + δO = 1 - δO := by simpa [h1] using hu
    have hcoe := congrArg (fun z : 𝓞 K => (z : K)) heq
    simp only [map_add, map_sub, map_one, coe_δO, sub_eq_add_neg] at hcoe
    have hδδ : δ = -δ := add_left_cancel hcoe
    have h2 : (2 : K) * δ = 0 := by
      have hsum : δ + δ = 0 := by
        nth_rewrite 2 [hδδ]
        exact add_neg_cancel δ
      have htwo : (2 : K) * δ = δ + δ := by ring
      rw [htwo, hsum]
    have hδ : δ = 0 := (mul_eq_zero.mp h2).resolve_left (by norm_num)
    have hzero : (0 : K) = -5 := by simpa [hδ] using delta_sq
    have h5 : (5 : K) = 0 := by
      have := congrArg (fun z : K => z + 5) hzero
      simpa using this
    have hQ : algebraMap ℚ K (5 : ℚ) + algebraMap ℚ K 0 * δ =
        algebraMap ℚ K 0 + algebraMap ℚ K 0 * δ := by
      simpa [map_zero, zero_mul, add_zero] using h5
    obtain ⟨ha, _⟩ := coord_unique hQ
    exact absurd ha (by norm_num)
  · have heq : (1 + δO) * (-1) = 1 - δO := by simpa [h1] using hu
    have hcoe := congrArg (fun z : 𝓞 K => (z : K)) heq
    simp only [map_mul, map_add, map_sub, map_one, map_neg, coe_δO] at hcoe
    have hl : (1 + δ) * (-1) = -1 + -δ := by ring
    rw [hl, sub_eq_add_neg] at hcoe
    have hneg : (-1 : K) = 1 := add_right_cancel hcoe
    have hQ : algebraMap ℚ K (-1 : ℚ) + algebraMap ℚ K 0 * δ =
        algebraMap ℚ K 1 + algebraMap ℚ K 0 * δ := by
      simpa [map_zero, zero_mul, add_zero, map_one, map_neg] using hneg
    obtain ⟨ha, _⟩ := coord_unique hQ
    exact absurd ha (by norm_num)

/-! ## Class number two -/

lemma p₂_mem : p₂ ∈ (Ideal (𝓞 K))⁰ :=
  Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by simp [absNorm_p₂])

lemma p₃_mem : p₃ ∈ (Ideal (𝓞 K))⁰ :=
  Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by simp [absNorm_p₃])

lemma p₃'_mem : p₃' ∈ (Ideal (𝓞 K))⁰ :=
  Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by simp [absNorm_p₃'])

lemma span_two_mem : Ideal.span {(2 : 𝓞 K)} ∈ (Ideal (𝓞 K))⁰ :=
  Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by simp [absNorm_span_two])

lemma span_one_add_mem : Ideal.span {1 + δO} ∈ (Ideal (𝓞 K))⁰ :=
  Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by
    rw [absNorm_one_add]
    decide)

lemma span_one_sub_mem : Ideal.span {1 - δO} ∈ (Ideal (𝓞 K))⁰ :=
  Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by
    rw [absNorm_one_sub]
    decide)

/-- Report §1: a principal ideal of norm `2` would require `a² + 5b² = 2`. -/
theorem p₂_not_principal : ¬ p₂.IsPrincipal := by
  intro h
  obtain ⟨a, ha⟩ := Submodule.IsPrincipal.principal (S := p₂)
  have hn : Ideal.absNorm p₂ = (Algebra.norm ℤ a).natAbs := by
    rw [ha, Ideal.absNorm_span_singleton]
  rw [absNorm_p₂] at hn
  have h2 : Algebra.norm ℤ a = 2 := by
    calc
      Algebra.norm ℤ a = |(Algebra.norm ℤ a)| := (abs_of_nonneg (norm_nonneg a)).symm
      _ = ((Algebra.norm ℤ a).natAbs : ℤ) := (Int.natCast_natAbs _).symm
      _ = 2 := by exact_mod_cast hn.symm
  rw [coe_eq_pair a, intNorm_pair] at h2
  exact no_norm_two (intA a) (intB a) h2

lemma p₂_class_ne_one : ClassGroup.mk0 ⟨p₂, p₂_mem⟩ ≠ 1 := by
  intro h
  exact p₂_not_principal ((ClassGroup.mk0_eq_one_iff p₂_mem).mp h)

lemma p₂_class_sq : (ClassGroup.mk0 ⟨p₂, p₂_mem⟩) ^ 2 = 1 := by
  rw [pow_two, ← map_mul]
  have heq : (⟨p₂, p₂_mem⟩ * ⟨p₂, p₂_mem⟩ : (Ideal (𝓞 K))⁰) =
      ⟨Ideal.span {(2 : 𝓞 K)}, span_two_mem⟩ := by
    apply Subtype.ext
    rw [Submonoid.coe_mul, ← pow_two, p₂_sq]
  rw [heq]
  exact (ClassGroup.mk0_eq_one_iff span_two_mem).mpr inferInstance

/-- Report §1: the class `[𝔭₂]` has order `2`. -/
theorem p₂_order : orderOf (ClassGroup.mk0 ⟨p₂, p₂_mem⟩) = 2 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact orderOf_eq_prime p₂_class_sq p₂_class_ne_one

/-- The only ideal of norm `2` is `𝔭₂`, because `(2) = 𝔭₂²`. -/
theorem eq_p₂_of_absNorm_eq_two {I : Ideal (𝓞 K)} (hI : Ideal.absNorm I = 2) : I = p₂ := by
  have hprime : I.IsPrime :=
    Ideal.isPrime_of_irreducible_absNorm (by
      rw [hI]
      exact (Nat.irreducible_iff_nat_prime 2).mpr Nat.prime_two)
  have hmem : (2 : 𝓞 K) ∈ I := by
    simpa [hI] using Ideal.absNorm_mem I
  have hle : p₂ ^ 2 ≤ I := by
    rw [p₂_sq, Ideal.span_singleton_le_iff_mem]
    exact hmem
  rw [pow_two] at hle
  have hp : p₂ ≤ I := (Ideal.IsPrime.mul_le hprime).mp hle |>.elim id id
  exact eq_of_le_of_absNorm_eq hp (by rw [hI, absNorm_p₂]) (by simp [hI])

/-- Report §1: every class is `[(1)]` or `[𝔭₂]`. -/
theorem class_eq_one_or_p₂ (C : ClassGroup (𝓞 K)) :
    C = 1 ∨ C = ClassGroup.mk0 ⟨p₂, p₂_mem⟩ := by
  obtain ⟨I, hI, hN⟩ := NumberField.exists_ideal_in_class_of_norm_le (K := K) C
  have hlt : Ideal.absNorm (I : Ideal (𝓞 K)) < 3 := by
    have hle : (Ideal.absNorm (I : Ideal (𝓞 K)) : ℝ) ≤ minkowskiBound := by
      rw [minkowskiBound]
      exact hN
    have : (Ideal.absNorm (I : Ideal (𝓞 K)) : ℝ) < 3 :=
      lt_of_le_of_lt hle minkowskiBound_lt_three
    exact_mod_cast this
  match hval : Ideal.absNorm (I : Ideal (𝓞 K)) with
  | 0 =>
      exact absurd hval (Ideal.absNorm_ne_zero_of_nonZeroDivisors I)
  | 1 =>
      left
      have htop : (I : Ideal (𝓞 K)) = ⊤ := Ideal.absNorm_eq_one_iff.mp hval
      rw [← hI]
      exact (ClassGroup.mk0_eq_one_iff I.property).mpr (by
        rw [htop]
        exact top_isPrincipal)
  | 2 =>
      right
      have hEq : (I : Ideal (𝓞 K)) = p₂ := eq_p₂_of_absNorm_eq_two hval
      rw [← hI, show I = ⟨p₂, p₂_mem⟩ from Subtype.ext hEq]
  | n + 3 =>
      rw [hval] at hlt
      omega

/-- Report §1: `Cl(𝒪_K) = { [(1)], [𝔭₂] }`. -/
theorem classGroup_card_eq_two : Nat.card (ClassGroup (𝓞 K)) = 2 := by
  rw [Nat.card_eq_two_iff]
  refine ⟨1, ClassGroup.mk0 ⟨p₂, p₂_mem⟩, p₂_class_ne_one.symm, ?_⟩
  ext C
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_univ, iff_true]
  exact class_eq_one_or_p₂ C

/-- Report §1: the class number is `2`. -/
theorem classNumber_eq_two : NumberField.classNumber K = 2 := by
  rw [NumberField.classNumber, Fintype.card_eq_nat_card]
  exact classGroup_card_eq_two

/-- Report §1: `Cl(𝒪_K) ≅ ℤ/2ℤ`. -/
theorem classGroup_isCyclic : IsCyclic (ClassGroup (𝓞 K)) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact isCyclic_of_prime_card (p := 2) classGroup_card_eq_two

/-- Report §1: `𝒪_K` is not a principal ideal domain. -/
theorem not_principalIdealRing : ¬ IsPrincipalIdealRing (𝓞 K) := by
  intro h
  have h1 := (NumberField.classNumber_eq_one_iff (K := K)).mpr h
  rw [classNumber_eq_two] at h1
  exact absurd h1 (by decide : (2 : ℕ) ≠ 1)

/-- Report §1: `[𝔭₃] = [𝔭₂]`. -/
theorem p₃_class_eq_p₂ :
    ClassGroup.mk0 ⟨p₃, p₃_mem⟩ = ClassGroup.mk0 ⟨p₂, p₂_mem⟩ := by
  have hmul : ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨p₃, p₃_mem⟩ = 1 := by
    rw [← map_mul]
    have heq : (⟨p₂, p₂_mem⟩ * ⟨p₃, p₃_mem⟩ : (Ideal (𝓞 K))⁰) =
        ⟨Ideal.span {1 + δO}, span_one_add_mem⟩ := by
      apply Subtype.ext
      rw [Submonoid.coe_mul, p₂_mul_p₃]
    rw [heq]
    exact (ClassGroup.mk0_eq_one_iff span_one_add_mem).mpr inferInstance
  have ha : ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨p₂, p₂_mem⟩ = 1 := by
    simpa [pow_two] using p₂_class_sq
  have : ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨p₃, p₃_mem⟩ =
      ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨p₂, p₂_mem⟩ := by
    rw [hmul, ha]
  exact mul_left_cancel this

/-- Report §1: `[𝔭₃′] = [𝔭₂]`. -/
theorem p₃'_class_eq_p₂ :
    ClassGroup.mk0 ⟨p₃', p₃'_mem⟩ = ClassGroup.mk0 ⟨p₂, p₂_mem⟩ := by
  have hmul : ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨p₃', p₃'_mem⟩ = 1 := by
    rw [← map_mul]
    have heq : (⟨p₂, p₂_mem⟩ * ⟨p₃', p₃'_mem⟩ : (Ideal (𝓞 K))⁰) =
        ⟨Ideal.span {1 - δO}, span_one_sub_mem⟩ := by
      apply Subtype.ext
      rw [Submonoid.coe_mul, p₂_mul_p₃']
    rw [heq]
    exact (ClassGroup.mk0_eq_one_iff span_one_sub_mem).mpr inferInstance
  have ha : ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨p₂, p₂_mem⟩ = 1 := by
    simpa [pow_two] using p₂_class_sq
  have : ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨p₃', p₃'_mem⟩ =
      ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨p₂, p₂_mem⟩ := by
    rw [hmul, ha]
  exact mul_left_cancel this

/-! ## Characters `χ_{−4}`, `χ₅`, and `χ_{−20}`

Report §4: "`χ_{−20} = χ_{−4} · χ₅`", with conductors 20, 4, and 5.
Mathlib names `ZMod.χ₄` and does not name `χ₅`. `χ₅` is defined here.
The product is proved below. The identity `ζ_K(s) = ζ(s) · L(s, χ_{−20})` is not a
Mathlib theorem; `dedekindZeta_factorization_gap` records that missing statement. -/

instance : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩

instance : NeZero (Nat.lcm 4 5) := ⟨by decide⟩

/-- Report §4: `χ₅` is the quadratic character modulo `5`, the character of `ℚ(√5)`.
`χ₅(n) = (n / 5)`. Mathlib has no named `χ₅`. -/
def χ₅ : DirichletCharacter ℤ 5 := quadraticChar (ZMod 5)

lemma χ₅_eq_legendre (n : ℤ) : χ₅ n = legendreSym 5 n := rfl

/-- Report §4: the level of `χ_{−4} · χ₅` is `lcm 4 5 = 20`. -/
theorem χ_neg20_level : Nat.lcm 4 5 = 20 := by decide

/-- Report §4: `χ_{−20} = χ_{−4} · χ₅`. -/
noncomputable def χ_neg20 : DirichletCharacter ℤ (Nat.lcm 4 5) :=
  DirichletCharacter.mul ZMod.χ₄ χ₅

/-- Report §4: `(−20 / n) = (−4 / n) · (5 / n)` at every integer, as values of these characters. -/
theorem χ_neg20_eq_mul (n : ℤ) : χ_neg20 n = ZMod.χ₄ n * χ₅ n := by
  by_cases h : IsCoprime n (Nat.lcm 4 5)
  · rw [χ_neg20, DirichletCharacter.mul, MulChar.mul_apply,
      DirichletCharacter.changeLevel_eq_cast_of_dvd' ZMod.χ₄ (Nat.dvd_lcm_left 4 5) h,
      DirichletCharacter.changeLevel_eq_cast_of_dvd' χ₅ (Nat.dvd_lcm_right 4 5) h]
  · have hzero : χ_neg20 n = 0 := (DirichletCharacter.apply_eq_zero_iff χ_neg20 n).mpr h
    have h4or5 : ¬ IsCoprime n (4 : ℕ) ∨ ¬ IsCoprime n (5 : ℕ) := by
      by_contra hboth
      push_neg at hboth
      have hmul : IsCoprime n ((4 : ℤ) * 5) := (IsCoprime.mul_right_iff).mpr hboth
      have hlcm : (Nat.lcm 4 5 : ℤ) = (4 : ℤ) * 5 := by decide
      exact h (hlcm ▸ hmul)
    rw [hzero]
    rcases h4or5 with h4 | h5
    · rw [(DirichletCharacter.apply_eq_zero_iff ZMod.χ₄ n).mpr h4, zero_mul]
    · rw [(DirichletCharacter.apply_eq_zero_iff χ₅ n).mpr h5, mul_zero]

/-- Report §4: on integers coprime to `20`, `χ_{−4}(n) · χ₅(n) · χ_{−20}(n) = 1`. -/
theorem three_char_eq_one {n : ℤ} (h : IsCoprime n (Nat.lcm 4 5)) :
    ZMod.χ₄ n * χ₅ n * χ_neg20 n = 1 := by
  have h4 : IsCoprime n (4 : ℕ) := IsCoprime.of_isCoprime_of_dvd_right h (by
    rw [χ_neg20_level]
    decide)
  have h5 : IsCoprime n (5 : ℕ) := IsCoprime.of_isCoprime_of_dvd_right h (by
    rw [χ_neg20_level]
    decide)
  have h4s : ZMod.χ₄ n * ZMod.χ₄ n = 1 := by
    have hne : ZMod.χ₄ n ≠ 0 := (DirichletCharacter.apply_ne_zero_iff ZMod.χ₄ n).mpr h4
    rcases ZMod.isQuadratic_χ₄ n with h0 | h1 | hm
    · exact absurd h0 hne
    · simp [h1]
    · simp [hm]
  have h5s : χ₅ n * χ₅ n = 1 := by
    have hne : χ₅ n ≠ 0 := (DirichletCharacter.apply_ne_zero_iff χ₅ n).mpr h5
    rw [χ₅_eq_legendre] at hne ⊢
    have hnz : (n : ZMod 5) ≠ 0 :=
      (legendreSym.eq_zero_iff 5 n).not.mp hne
    rcases legendreSym.eq_one_or_neg_one (p := 5) hnz with h1 | hm
    · simp [h1]
    · simp [hm]
  rw [χ_neg20_eq_mul]
  calc
    ZMod.χ₄ n * χ₅ n * (ZMod.χ₄ n * χ₅ n)
        = ZMod.χ₄ n * ZMod.χ₄ n * (χ₅ n * χ₅ n) := by ring
    _ = 1 := by rw [h4s, h5s, mul_one]

/-- The complex character attached to `χ_neg20`, for the L-function in the zeta gap. -/
noncomputable def χ_neg20ℂ : DirichletCharacter ℂ (Nat.lcm 4 5) :=
  χ_neg20.ringHomComp (Int.castRingHom ℂ)

/-- Report §4: `ζ_K(s) = ζ(s) · L(s, χ_{−20})`.

Mathlib defines `dedekindZeta` and `DirichletCharacter.LFunction`. It does not prove
this identity for `K = ℚ(√−5)`. This definition is that missing statement. It is a
proposition, not an axiom, and it is not proved here. -/
def dedekindZeta_factorization_gap : Prop :=
  ∀ s : ℂ, dedekindZeta K s = riemannZeta s * DirichletCharacter.LFunction χ_neg20ℂ s

/-! ## The primes 7, 67, and 107 -/

/-- Conjugate on `ℤ[δ]`: `a + bδ ↦ a − bδ`. -/
noncomputable def conjO (x : 𝓞 K) : 𝓞 K := pairO (intA x) (-intB x)

lemma conjO_pair (a b : ℤ) : conjO (pairO a b) = pairO a (-b) := by
  simp [conjO, intA_pair, intB_pair]

lemma intA_neg (x : 𝓞 K) : intA (-x) = -intA x := by
  rw [← neg_one_zsmul]
  simpa using intA_zsmul (-1) x

lemma intB_neg (x : 𝓞 K) : intB (-x) = -intB x := by
  rw [← neg_one_zsmul]
  simpa using intB_zsmul (-1) x

lemma intA_conjO (x : 𝓞 K) : intA (conjO x) = intA x := by
  simp [conjO, intA_pair]

lemma intB_conjO (x : 𝓞 K) : intB (conjO x) = -intB x := by
  simp [conjO, intB_pair]

lemma mul_pair_conj (a b : ℤ) :
    pairO a b * pairO a (-b) = algebraMap ℤ (𝓞 K) (a ^ 2 + 5 * b ^ 2) := by
  apply RingOfIntegers.ext
  change (pairO a b : K) * (pairO a (-b) : K) = algebraMap ℤ K (a ^ 2 + 5 * b ^ 2)
  rw [coe_pairO, coe_pairO, map_neg]
  have hδ : δ ^ 2 = -5 := delta_sq
  ring_nf
  rw [hδ]
  ring_nf
  simp [map_add, map_mul, map_pow, map_ofNat, map_neg]

lemma mul_conjO (x : 𝓞 K) : x * conjO x = algebraMap ℤ (𝓞 K) (Algebra.norm ℤ x) := by
  have hx : x = pairO (intA x) (intB x) := coe_eq_pair x
  rw [hx, conjO_pair, mul_pair_conj, intNorm_pair]

lemma mem_p₂_of_eq (z r s : 𝓞 K) (h : z = r * 2 + s * (1 + δO)) : z ∈ p₂ := by
  rw [p₂, Ideal.mem_span_pair]
  exact ⟨r, s, h.symm⟩

/-- Report §5: `(5 / p) = −1` when `p ≡ 3 (mod 4)` and `p ≡ 2 (mod 5)`.
That is inertness in `ℚ(√5)`. -/
theorem legendre_five_neg_one {p : ℕ} [Fact p.Prime] (h4 : p % 4 = 3) (h5 : p % 5 = 2) :
    legendreSym p 5 = -1 := by
  have hq : p ≠ 2 := by
    intro hp
    rw [hp] at h4
    exact absurd h4 (by decide : 2 % 4 ≠ 3)
  calc
    legendreSym p 5 = legendreSym 5 (p : ℤ) :=
      legendreSym.quadratic_reciprocity_one_mod_four (p := 5) (q := p) (by decide) hq
    _ = legendreSym 5 ((p : ℤ) % 5) := legendreSym.mod 5 (p : ℤ)
    _ = legendreSym 5 2 := by
      have hmod : (p : ℤ) % 5 = (2 : ℤ) := by omega
      rw [hmod]
    _ = ZMod.χ₈ 5 := legendreSym.at_two (by decide : (5 : ℕ) ≠ 2)
    _ = -1 := rfl

/-- Report §5: `χ_{−20}(p) = 1` for such a prime, so `p` splits in `ℚ(√−5)`. -/
theorem χ_neg20_split {p : ℕ} [Fact p.Prime] (h4 : p % 4 = 3) (h5 : p % 5 = 2) :
    χ_neg20 (p : ℤ) = 1 := by
  have hχ4 : ZMod.χ₄ (p : ℤ) = -1 := by
    have hmod : (p : ℤ) % 4 = 3 := by omega
    exact ZMod.χ₄_int_three_mod_four hmod
  have hχ5 : χ₅ (p : ℤ) = -1 := by
    rw [χ₅_eq_legendre]
    calc
      legendreSym 5 (p : ℤ) = legendreSym p 5 :=
        (legendreSym.quadratic_reciprocity_one_mod_four (p := 5) (q := p) (by decide)
          (by intro hp; rw [hp] at h4; exact absurd h4 (by decide : 2 % 4 ≠ 3))).symm
      _ = -1 := legendre_five_neg_one h4 h5
  rw [χ_neg20_eq_mul, hχ4, hχ5]
  decide

lemma class_eq_p₂_of_factor (Q : Ideal (𝓞 K)) (α : 𝓞 K) (hQ : Q ∈ (Ideal (𝓞 K))⁰)
    (hα : Ideal.span {α} ∈ (Ideal (𝓞 K))⁰) (hmul : p₂ * Q = Ideal.span {α}) :
    ClassGroup.mk0 ⟨Q, hQ⟩ = ClassGroup.mk0 ⟨p₂, p₂_mem⟩ := by
  have hmul1 : ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨Q, hQ⟩ = 1 := by
    rw [← map_mul]
    have heq : (⟨p₂, p₂_mem⟩ * ⟨Q, hQ⟩ : (Ideal (𝓞 K))⁰) =
        ⟨Ideal.span {α}, hα⟩ := by
      apply Subtype.ext
      rw [Submonoid.coe_mul, hmul]
    rw [heq]
    exact (ClassGroup.mk0_eq_one_iff hα).mpr inferInstance
  have ha : ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨p₂, p₂_mem⟩ = 1 := by
    simpa [pow_two] using p₂_class_sq
  have : ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨Q, hQ⟩ =
      ClassGroup.mk0 ⟨p₂, p₂_mem⟩ * ClassGroup.mk0 ⟨p₂, p₂_mem⟩ := by
    rw [hmul1, ha]
  exact mul_left_cancel this

lemma span_mem_of_norm {α : 𝓞 K} {p : ℕ} (hnorm : Algebra.norm ℤ α = (2 * p : ℤ))
    (hp : p ≠ 0) : Ideal.span {α} ∈ (Ideal (𝓞 K))⁰ :=
  Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by
    rw [Ideal.absNorm_span_singleton, hnorm, show ((2 : ℤ) * p).natAbs = 2 * p by
      rw [show (2 : ℤ) * (p : ℤ) = ((2 * p : ℕ) : ℤ) by simp [Nat.cast_mul], Int.natAbs_natCast]]
    exact mul_ne_zero (by decide) hp)

/-- Report §5: an element `α ∈ 𝔭₂` of norm `2p`, with conjugate also in `𝔭₂`,
gives the splitting `(p) = 𝔮 𝔮′` into the class of `𝔭₂`. -/
theorem split_of_norm_two_p {p : ℕ} (hp : Nat.Prime p) (α : 𝓞 K) (hmem : α ∈ p₂)
    (hmem' : conjO α ∈ p₂) (hnorm : Algebra.norm ℤ α = (2 * p : ℤ))
    (ha : intA α ≠ 0) (hb : intB α ≠ 0) :
    ∃ Q Q' : Ideal (𝓞 K), ∃ (hQ : Q ∈ (Ideal (𝓞 K))⁰) (hQ' : Q' ∈ (Ideal (𝓞 K))⁰),
      p₂ * Q = Ideal.span {α} ∧
      p₂ * Q' = Ideal.span {conjO α} ∧
      Q * Q' = Ideal.span {(p : 𝓞 K)} ∧
      Q ≠ Q' ∧
      Q.IsPrime ∧
      Q'.IsPrime ∧
      Ideal.absNorm Q = p ∧
      Ideal.absNorm Q' = p ∧
      ClassGroup.mk0 ⟨Q, hQ⟩ = ClassGroup.mk0 ⟨p₂, p₂_mem⟩ ∧
      ClassGroup.mk0 ⟨Q', hQ'⟩ = ClassGroup.mk0 ⟨p₂, p₂_mem⟩ := by
  obtain ⟨Q, hQmul⟩ := Ideal.dvd_span_singleton.mpr hmem
  obtain ⟨Q', hQ'mul⟩ := Ideal.dvd_span_singleton.mpr hmem'
  have hnatAbs : ((2 : ℤ) * p).natAbs = 2 * p := by
    rw [show (2 : ℤ) * (p : ℤ) = ((2 * p : ℕ) : ℤ) by simp [Nat.cast_mul], Int.natAbs_natCast]
  have hNa : Ideal.absNorm (Ideal.span {α}) = 2 * p := by
    rw [Ideal.absNorm_span_singleton, hnorm, hnatAbs]
  have hNQ : Ideal.absNorm Q = p := by
    have hmul : Ideal.absNorm p₂ * Ideal.absNorm Q = 2 * p := by
      rw [← map_mul Ideal.absNorm, ← hQmul, hNa]
    rw [absNorm_p₂] at hmul
    exact Nat.eq_of_mul_eq_mul_left (by decide : 0 < 2) hmul
  have hnorm' : Algebra.norm ℤ (conjO α) = (2 * p : ℤ) := by
    have hconj : conjO α = pairO (intA α) (-intB α) := by
      conv_lhs => rw [coe_eq_pair α]
      exact conjO_pair (intA α) (intB α)
    rw [hconj]
    calc
      Algebra.norm ℤ (pairO (intA α) (-intB α))
          = (intA α) ^ 2 + 5 * (-intB α) ^ 2 := intNorm_pair _ _
      _ = (intA α) ^ 2 + 5 * (intB α) ^ 2 := by rw [neg_sq]
      _ = Algebra.norm ℤ (pairO (intA α) (intB α)) := (intNorm_pair _ _).symm
      _ = Algebra.norm ℤ α := by rw [(coe_eq_pair α).symm]
      _ = (2 * p : ℤ) := hnorm
  have hNQ' : Ideal.absNorm Q' = p := by
    have hmul : Ideal.absNorm p₂ * Ideal.absNorm Q' = 2 * p := by
      have hNc : Ideal.absNorm (Ideal.span {conjO α}) = 2 * p := by
        rw [Ideal.absNorm_span_singleton, hnorm', hnatAbs]
      rw [← map_mul Ideal.absNorm, ← hQ'mul, hNc]
    rw [absNorm_p₂] at hmul
    exact Nat.eq_of_mul_eq_mul_left (by decide : 0 < 2) hmul
  have hQ : Q ∈ (Ideal (𝓞 K))⁰ :=
    Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by rw [hNQ]; exact hp.ne_zero)
  have hQ' : Q' ∈ (Ideal (𝓞 K))⁰ :=
    Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by rw [hNQ']; exact hp.ne_zero)
  have hαmem : Ideal.span {α} ∈ (Ideal (𝓞 K))⁰ := span_mem_of_norm hnorm hp.ne_zero
  have hα'mem : Ideal.span {conjO α} ∈ (Ideal (𝓞 K))⁰ :=
    span_mem_of_norm hnorm' hp.ne_zero
  have hfac : Q * Q' = Ideal.span {(p : 𝓞 K)} := by
    have hprod : Ideal.span {α} * Ideal.span {conjO α} =
        Ideal.span {(2 : 𝓞 K)} * Ideal.span {(p : 𝓞 K)} := by
      rw [Ideal.span_singleton_mul_span_singleton, mul_conjO, hnorm]
      have hcast : algebraMap ℤ (𝓞 K) ((2 : ℤ) * p) = (2 : 𝓞 K) * (p : 𝓞 K) := by
        simp [map_mul]
      rw [hcast, Ideal.span_singleton_mul_span_singleton]
    have hleft : p₂ * Q * (p₂ * Q') = p₂ ^ 2 * (Q * Q') := by
      rw [pow_two]
      ac_rfl
    have hright : p₂ ^ 2 * (Q * Q') = p₂ ^ 2 * Ideal.span {(p : 𝓞 K)} := by
      rw [← hleft, ← hQmul, ← hQ'mul, hprod, p₂_sq]
    have hp2 : p₂ ^ 2 ≠ 0 := by
      rw [p₂_sq]
      intro hbot
      have h2 : (2 : 𝓞 K) = 0 := Ideal.span_singleton_eq_bot.mp hbot
      have := congrArg (Algebra.norm ℤ) h2
      rw [norm_two, (norm_eq_zero_iff (0 : 𝓞 K)).mpr rfl] at this
      exact absurd this (by decide)
    exact mul_left_cancel₀ hp2 hright
  have hne : Q ≠ Q' := by
    intro hQQ
    have hassoc : Associated α (conjO α) :=
      (Ideal.span_singleton_eq_span_singleton).mp (by rw [hQmul, hQ'mul, hQQ])
    obtain ⟨u, hu⟩ := hassoc
    rcases (isUnit_iff (u : 𝓞 K)).mp u.isUnit with h1 | h1
    · have heq : α = conjO α := by simpa [h1] using hu
      have hb0 : intB α = -intB α := by
        have := congrArg intB heq
        rwa [intB_conjO] at this
      have hsum : (2 : ℤ) * intB α = 0 := by
        calc
          (2 : ℤ) * intB α = intB α + intB α := by ring
          _ = intB α + -intB α := by
            nth_rewrite 2 [hb0]
            rfl
          _ = 0 := add_neg_cancel _
      exact hb ((mul_eq_zero.mp hsum).resolve_left (by decide))
    · have heq : -α = conjO α := by
        have hneg : α * (-1) = conjO α := by simpa [h1] using hu
        simpa [mul_neg, mul_one] using hneg
      have ha0 : -intA α = intA α := by
        have := congrArg intA heq
        rwa [intA_neg, intA_conjO] at this
      have hsum : (2 : ℤ) * intA α = 0 := by
        calc
          (2 : ℤ) * intA α = intA α + intA α := by ring
          _ = -intA α + intA α := by
            nth_rewrite 1 [← ha0]
            rfl
          _ = 0 := neg_add_cancel _
      exact ha ((mul_eq_zero.mp hsum).resolve_left (by decide))
  have hprime : Q.IsPrime :=
    Ideal.isPrime_of_irreducible_absNorm (by
      rw [hNQ]
      exact (Nat.irreducible_iff_nat_prime p).mpr hp)
  have hprime' : Q'.IsPrime :=
    Ideal.isPrime_of_irreducible_absNorm (by
      rw [hNQ']
      exact (Nat.irreducible_iff_nat_prime p).mpr hp)
  have hclass := class_eq_p₂_of_factor Q α hQ hαmem hQmul.symm
  have hclass' := class_eq_p₂_of_factor Q' (conjO α) hQ' hα'mem hQ'mul.symm
  exact ⟨Q, Q', hQ, hQ', hQmul.symm, hQ'mul.symm, hfac, hne, hprime, hprime', hNQ, hNQ',
    hclass, hclass'⟩

lemma pair_lincomb (a b r s : ℤ) (h : a = 2 * r + s ∧ b = s) :
    pairO a b = (r : 𝓞 K) * 2 + (s : 𝓞 K) * (1 + δO) := by
  apply RingOfIntegers.ext
  have hrhs : ((r : 𝓞 K) * 2 + (s : 𝓞 K) * (1 + δO) : K) =
      algebraMap ℤ K (2 * r + s) + algebraMap ℤ K s * δ := by
    simp [map_add, map_mul, coe_δO, map_ofNat, map_intCast, map_one, add_mul, mul_add]
    ring
  rw [coe_pairO, h.1, h.2]
  exact hrhs.symm

instance : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩

instance : Fact (Nat.Prime 67) := ⟨by decide⟩

instance : Fact (Nat.Prime 107) := ⟨by decide⟩

/-- Report §5: `7` is inert in `ℚ(i)` and in `ℚ(√5)`, and splits in `ℚ(√−5)`
into the class of `𝔭₂`. `N(3+δ) = 14 = 2·7`, and `3+δ = (1+δ) + 2`. -/
theorem seven_home :
    Prime (7 : GaussianInt) ∧
    legendreSym 7 5 = -1 ∧
    χ_neg20 (7 : ℤ) = 1 ∧
    ∃ Q Q' : Ideal (𝓞 K), ∃ (hQ : Q ∈ (Ideal (𝓞 K))⁰) (hQ' : Q' ∈ (Ideal (𝓞 K))⁰),
      p₂ * Q = Ideal.span {pairO 3 1} ∧
      Q * Q' = Ideal.span {(7 : 𝓞 K)} ∧
      Q ≠ Q' ∧
      ClassGroup.mk0 ⟨Q, hQ⟩ = ClassGroup.mk0 ⟨p₂, p₂_mem⟩ ∧
      ClassGroup.mk0 ⟨Q', hQ'⟩ = ClassGroup.mk0 ⟨p₂, p₂_mem⟩ := by
  haveI : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  have hg : Prime (7 : GaussianInt) :=
    GaussianInt.prime_of_nat_prime_of_mod_four_eq_three 7 (by decide)
  have hleg : legendreSym 7 5 = -1 := legendre_five_neg_one (by decide) (by decide)
  have hχ : χ_neg20 (7 : ℤ) = 1 := χ_neg20_split (by decide) (by decide)
  have hmem : pairO 3 1 ∈ p₂ :=
    mem_p₂_of_eq _ ((1 : ℤ) : 𝓞 K) ((1 : ℤ) : 𝓞 K)
      (pair_lincomb 3 1 1 1 ⟨by decide, by decide⟩)
  have hmem' : conjO (pairO 3 1) ∈ p₂ := by
    rw [conjO_pair]
    exact mem_p₂_of_eq _ ((2 : ℤ) : 𝓞 K) ((-1 : ℤ) : 𝓞 K)
      (pair_lincomb 3 (-1) 2 (-1) ⟨by decide, by decide⟩)
  have hnorm : Algebra.norm ℤ (pairO 3 1) = (2 * 7 : ℤ) := by
    rw [intNorm_pair]
    norm_num
  have hsplit := split_of_norm_two_p Nat.prime_seven (pairO 3 1) hmem hmem' hnorm
    (by simp [intA_pair]) (by simp [intB_pair])
  obtain ⟨Q, Q', hQ, hQ', hQmul, _, hfac, hne, _, _, _, _, hclass, hclass'⟩ := hsplit
  exact ⟨hg, hleg, hχ, Q, Q', hQ, hQ', hQmul, hfac, hne, hclass, hclass'⟩

/-- Report §5: `67` is inert in `ℚ(i)` and in `ℚ(√5)`, and splits in `ℚ(√−5)`
into the class of `𝔭₂`. `N(3+5δ) = 134 = 2·67`, and `3+5δ = 5(1+δ) − 2`. -/
