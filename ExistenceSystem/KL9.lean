public import Mathlib
public import ExistenceSystem.KL24
public import ExistenceSystem.KL6
public import ExistenceSystem.KL7

@[expose] public section

open scoped Topology

namespace ExistenceSystem.KL9

/-! ## §1. Part (i) — the Lyapunov descent and the uniqueness of the trajectory (Note L858–L860)

The relaxational dynamics (6.1) with ξ=0 is the gradient flow `w'(t) = −Γ_⊥·∇J(w t)` of the energy
`J` on the field Hilbert space `F = L²(Ω, E_⊥)`, where `∇J = δJ/δw` is the functional gradient and
`∫_Ω|δJ/δw|² d³x = ‖∇J‖²`. Everything here is abstract on that space. -/

section Lyapunov

variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]

/-- **Note L858, her Lyapunov identity, PROVED.** Along the gradient flow `w'(t)=−Γ_⊥·∇J(w t)`, with
`∇J` the gradient of `J` (`HasGradientAt J (grad (w t)) (w t)`), the energy descends at the exact
rate  `dJ/dt = −Γ_⊥‖∇J(w t)‖²`.  Here `‖∇J‖²` is her `∫_Ω|δJ/δw|² d³x` in the L² inner product; the
proof is the chain rule `∇J ⬝ w'`. -/
theorem lyapunov_rate (J : F → ℝ) (grad : F → F) (w : ℝ → F) (Γ : ℝ) (t : ℝ)
    (hgrad : HasGradientAt J (grad (w t)) (w t))
    (hflow : HasDerivAt w (-(Γ • grad (w t))) t) :
    HasDerivAt (fun s => J (w s)) (-(Γ * ‖grad (w t)‖ ^ 2)) t := by
  have hcomp : HasDerivAt (fun s => J (w s))
      ((InnerProductSpace.toDual ℝ F (grad (w t))) (-(Γ • grad (w t)))) t :=
    hgrad.hasFDerivAt.comp_hasDerivAt t hflow
  have hval : (InnerProductSpace.toDual ℝ F (grad (w t))) (-(Γ • grad (w t)))
      = -(Γ * ‖grad (w t)‖ ^ 2) := by
    rw [InnerProductSpace.toDual_apply_apply, inner_neg_right, real_inner_smul_right,
      real_inner_self_eq_norm_sq]
  rwa [hval] at hcomp

/-- **Note L858, "… ≤ 0", PROVED.** With a non-negative mobility `Γ_⊥`, the energy is non-increasing
along the flow: `dJ/dt ≤ 0`. -/
theorem lyapunov_nonpos (J : F → ℝ) (grad : F → F) (w : ℝ → F) (Γ : ℝ) (t : ℝ)
    (hΓ : 0 ≤ Γ)
    (hgrad : HasGradientAt J (grad (w t)) (w t))
    (hflow : HasDerivAt w (-(Γ • grad (w t))) t) :
    deriv (fun s => J (w s)) t ≤ 0 := by
  rw [(lyapunov_rate J grad w Γ t hgrad hflow).deriv]
  have : 0 ≤ Γ * ‖grad (w t)‖ ^ 2 := mul_nonneg hΓ (by positivity)
  linarith

/-- **Note L858, the *strict* clause "with equality if and only if δJ/δw≡0", PROVED.** With a strictly
positive mobility `Γ_⊥`, the descent rate is zero exactly when the functional gradient vanishes — the
content of "`J` a **strict** Lyapunov function". -/
theorem lyapunov_eq_zero_iff (J : F → ℝ) (grad : F → F) (w : ℝ → F) (Γ : ℝ) (t : ℝ)
    (hΓ : 0 < Γ)
    (hgrad : HasGradientAt J (grad (w t)) (w t))
    (hflow : HasDerivAt w (-(Γ • grad (w t))) t) :
    deriv (fun s => J (w s)) t = 0 ↔ grad (w t) = 0 := by
  rw [(lyapunov_rate J grad w Γ t hgrad hflow).deriv]
  rw [neg_eq_zero, mul_eq_zero]
  constructor
  · rintro (h | h)
    · exact absurd h (ne_of_gt hΓ)
    · exact norm_eq_zero.mp (by nlinarith [norm_nonneg (grad (w t))])
  · intro h
    right
    rw [h, norm_zero]
    ring

omit [CompleteSpace F] in
/-- **Note L860, "The trajectory from any initial datum is unique", PROVED (well-posedness carried).**
Two trajectories of the autonomous gradient-flow field `V` (here `V x = −Γ_⊥·∇J(x)`) that start at
the same datum coincide on `[a,b]`. The engine is Mathlib's ODE uniqueness; its only input is that
`V` is Lipschitz — exactly the smoothness/well-posedness the Note marks "standard" (Note L891),
supplied as the named hypothesis `hlip`, since Mathlib carries no parabolic well-posedness. -/
theorem trajectory_unique (V : F → F) (K : NNReal) (hlip : LipschitzWith K V)
    {w₁ w₂ : ℝ → F} {a b : ℝ}
    (hc₁ : ContinuousOn w₁ (Set.Icc a b))
    (hd₁ : ∀ t ∈ Set.Ico a b, HasDerivWithinAt w₁ (V (w₁ t)) (Set.Ici t) t)
    (hc₂ : ContinuousOn w₂ (Set.Icc a b))
    (hd₂ : ∀ t ∈ Set.Ico a b, HasDerivWithinAt w₂ (V (w₂ t)) (Set.Ici t) t)
    (hinit : w₁ a = w₂ a) :
    Set.EqOn w₁ w₂ (Set.Icc a b) :=
  ODE_solution_unique (v := fun _ => V) (fun _ => hlip) hc₁ hd₁ hc₂ hd₂ hinit

end Lyapunov

/-! ## §2. Part (ii) — every uniform phason is an exact equilibrium (Note L864)

Rides KL24 (`gradient_only_divergence`: δJ/δw = −∂_x Π) and KL6 (a uniform shift has no gradient). In
KL24's one-variable reduction, `δJ/δw` at a point is `EulerLagrange.el (deriv (landauScalar a c))
stress`, where `stress = Π`. For a uniform phason `∇w₀=0`, so Π carries no field term and is spatially
constant; her proof (Note L893): "∇w₀=0 ⟹ Π=K₃Mu ⟹ (unstrained) Π constant ⟹ ∂_kΠ=0 ⟹ ∂_tw=0". -/

section Uniform

open ExistenceSystem.KL24 ExistenceSystem.EulerLagrange

/-- **Note L893, "∇w₀=0" (reused from §4.6).** A uniform phason value `w₀` has zero gradient: the
Fréchet derivative of the constant field `_ ↦ w₀` is the zero map (`KL6.uniform_shift_grad_zero`). So
Π loses its gradient dependence and reduces to the strain/phonon term `K₃Mu`. -/
theorem uniform_shift_grad_zero (w₀ r : Fin 3 → ℝ) :
    fderiv ℝ (fun _ : Fin 3 → ℝ => w₀) r = 0 :=
  ExistenceSystem.KL6.uniform_shift_grad_zero w₀ r

/-- **Note L864 / L893, every uniform phason is an exact equilibrium, PROVED.** For a uniform phason
the stress `Π` is spatially constant (previous lemma: no gradient dependence, and unstrained so
`K₃Mu` is constant). By KL24 (`gradient_only_divergence`) the functional derivative is
`δJ/δw=−∂_xΠ=−(d/dx const)=0` at every point, so the gradient-flow velocity `−Γ_⊥·δJ/δw` is `0`:
`∂_tw≡0`. The Landau bare-field part is already killed by KL24 step 1 under admissibility `hadm`. -/
theorem uniform_equilibrium {N : ℕ} (a : Fin N → ℂ)
    (c : Fin N → Σ M : ℕ, Fin M → (Fin 6 → ℤ))
    (hadm : ∀ j, (∑ m, (c j).2 m) = 0) (Γ : ℝ) (s : ℝ) (x : ℝ) :
    -(Γ * EulerLagrange.el (deriv (landauScalar a c)) (fun _ => s) x) = 0 := by
  rw [gradient_only_divergence a c hadm (fun _ => s) x, deriv_const]
  ring

/-- **Note L864, "The set of uniform equilibria is all of E_⊥", PROVED (reuses KL7).** Every uniform
`w₀∈E_⊥` is a global minimiser of the (flat) energy over `E_⊥` — the whole free subspace is the
arg-min (`KL7.isMinOn_free`, abstract on KL6's invariance `hInv`). Minimisation under-determines `w`:
it is indifferent to the phason, so every uniform `w₀` rests where it starts. -/
theorem uniform_equilibria_fill_Eperp {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Eperp : Submodule ℝ E) (J : E → ℝ)
    (hInv : ∀ x : E, ∀ w ∈ Eperp, J (x + w) = J x)
    (x : E) {w₀ : E} (h₀ : w₀ ∈ Eperp) :
    IsMinOn (fun w => J (x + w)) (Eperp : Set E) w₀ :=
  ExistenceSystem.KL7.isMinOn_free Eperp J hInv x h₀

end Uniform

/-! ## §3. Part (iii) — the mean phason is an exact constant of the motion (Note L866–L879, L895–L899)

Her chain: δJ/δw_m=−∂_kΠ_km (Lemma 3 = KL24); d/dt∫_Ω w_m = Γ_⊥∫_Ω∂_kΠ_km = Γ_⊥∮_∂Ω Π_km n_k dS = 0.
The genuinely closeable heart — the flux integral vanishes — is `flux_integral_zero`, the one-variable
form of her surface integral: ∫_a^b ∂_xΠ dx = Π(b)−Π(a) = 0 under either boundary condition. -/

section Mean

/-- **Note L899, her surface integral `Γ_⊥∮_∂Ω Π_km n_k dS = 0`, the one-variable core, PROVED.**
The integral of the flux divergence `∂_xΠ` over the sample `[a,b]` is the boundary term `Π(b)−Π(a)`
(fundamental theorem of calculus), which **vanishes under either of her boundary conditions**:
periodic (`Π a = Π b`) or free/zero-phason-stress (`Π a = Π b = 0`, a special case of `Π a = Π b`).
`dΠ` is the pointwise spatial derivative of `Π` (`Π` is `C¹` on the closed sample — her (H8)). -/
theorem flux_integral_zero (stress dstress : ℝ → ℝ) (a b : ℝ)
    (hderiv : ∀ x ∈ Set.uIcc a b, HasDerivAt stress (dstress x) x)
    (hint : IntervalIntegrable dstress MeasureTheory.volume a b)
    (hbdry : stress a = stress b) :
    ∫ x in a..b, dstress x = 0 := by
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint, hbdry, sub_self]

/-- **Note L877, the boxed `dw̄/dt=0 exactly, for all time`, PROVED (the divergence core) + one
carried regularity step.** `mean` is the component mean `w̄_m(t)=|Ω|⁻¹∫_Ω w_m d³x` as a function of
time. The single step **carried** as a named hypothesis is `hmean_rate` — that its time-derivative is
`Γ_⊥` times the flux integral `fluxInt t` — which is her "by (H3) Γ_⊥ passes outside the integral; by
(H7) d/dt commutes with it; by (H4)+Lemma 3 ∂_tw=Γ_⊥∂_xΠ": differentiation under the integral sign
for the stated solution (G5 §3.4, "given a solution with the stated regularity"). The flux integral it
multiplies **is proved zero** (`hflux`, from `flux_integral_zero`). Hence the mean is constant for all
time. -/
theorem mean_conserved (mean : ℝ → ℝ) (Γ : ℝ) (fluxInt : ℝ → ℝ)
    (hmean_rate : ∀ t, HasDerivAt mean (Γ * fluxInt t) t)
    (hflux : ∀ t, fluxInt t = 0) :
    ∀ t₁ t₂, mean t₁ = mean t₂ := by
  have hz : ∀ t, HasDerivAt mean 0 t := by
    intro t
    have h := hmean_rate t
    rwa [hflux t, mul_zero] at h
  have hdiff : Differentiable ℝ mean := fun t => (hz t).differentiableAt
  have hderiv0 : ∀ t, deriv mean t = 0 := fun t => (hz t).deriv
  exact is_const_of_deriv_eq_zero hdiff hderiv0

/-- **Note L877 + L899, the capstone of (iii), PROVED.** Combines the two: when the mean's time-rate
is `Γ_⊥` times the flux integral (carried regularity) and the stress meets either boundary condition
(so the flux integral vanishes, `flux_integral_zero`), the mean phason is an exact constant of the
motion — `dw̄/dt=0 exactly, for all time`. -/
theorem mean_conserved_of_boundary (mean : ℝ → ℝ) (Γ : ℝ)
    (stress dstress : ℝ → ℝ → ℝ) (a b : ℝ)
    (hmean_rate : ∀ t, HasDerivAt mean (Γ * ∫ x in a..b, dstress t x) t)
    (hderiv : ∀ t, ∀ x ∈ Set.uIcc a b, HasDerivAt (stress t) (dstress t x) x)
    (hint : ∀ t, IntervalIntegrable (dstress t) MeasureTheory.volume a b)
    (hbdry : ∀ t, stress t a = stress t b) :
    ∀ t₁ t₂, mean t₁ = mean t₂ :=
  mean_conserved mean Γ (fun t => ∫ x in a..b, dstress t x) hmean_rate
    (fun t => flux_integral_zero (stress t) (dstress t) a b (hderiv t) (hint t) (hbdry t))

end Mean

/-! ## §4. Part (iv) — the flow relaxes to the initial mean (Note L881–L883, L903)

The FRONTIER. Her decay rate `≥ Γ_⊥ K_min q_min² > 0` rests on a Poincaré/spectral-gap inequality
(Mathlib: NOT FOUND, G5 §3.1) and on the parabolic well-posedness marked "standard". The exponential
decay of the remainder is carried as the named hypothesis `SpectralGapDecay`; from it, her conclusion
`w(·,t)→w̄(0)` is proved. -/

section Relaxation

variable {F : Type*} [NormedAddCommGroup F]

/-- **Note L903, the named-hypothesis FRONTIER.** "every nonzero Fourier mode decays at rate
`≥ Γ_⊥ K_min q_min² > 0`" — the remainder `w(·,t) − w̄(0)` decays exponentially, at a positive rate.
Deriving this rate from the parabolic equation needs the spectral gap / Poincaré inequality for the
elastic operator (absent from Mathlib, G5 §3.1) and the well-posedness marked "standard"; those are
the deferred project (G5 §3.4). This structure carries the decay as a labelled input (the KL16
`SplittingData`/`ExhaustiveToBound` discipline), never a `sorry`/axiom. -/
structure SpectralGapDecay (w : ℝ → F) (wbar : F) (rate coeff : ℝ) : Prop where
  /-- the per-mode decay rate `≥ Γ_⊥ K_min q_min²` is strictly positive — "`> 0`" -/
  rate_pos : 0 < rate
  /-- the prefactor (set by the initial datum's regularity) is non-negative -/
  coeff_nonneg : 0 ≤ coeff
  /-- the remainder decays exponentially at that rate -/
  decay : ∀ t, ‖w t - wbar‖ ≤ coeff * Real.exp (-(rate * t))

/-- **Note L881–L883, "The flow relaxes to the initial mean", her consequence PROVED.** Given the
named `SpectralGapDecay` of the remainder about the (frozen, by (iii)) initial mean `w̄(0)`, the field
converges to that mean: `lim_{t→∞} w(·,t) = w̄(0)`. The proof is a squeeze — `0 ≤ ‖w t − w̄(0)‖ ≤
coeff·exp(−rate·t) → 0`. The faithful translation of her "Hence w(·,t)→w̄(0)". -/
theorem relaxes_to_mean (w : ℝ → F) (wbar : F) (rate coeff : ℝ)
    (h : SpectralGapDecay w wbar rate coeff) :
    Filter.Tendsto w Filter.atTop (𝓝 wbar) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  have hrate : Filter.Tendsto (fun t : ℝ => rate * t) Filter.atTop Filter.atTop :=
    Filter.Tendsto.const_mul_atTop h.rate_pos Filter.tendsto_id
  have hexp : Filter.Tendsto (fun t : ℝ => Real.exp (-(rate * t))) Filter.atTop (𝓝 0) :=
    Real.tendsto_exp_neg_atTop_nhds_zero.comp hrate
  have hg : Filter.Tendsto (fun t : ℝ => coeff * Real.exp (-(rate * t)))
      Filter.atTop (𝓝 0) := by
    have := hexp.const_mul coeff
    simpa using this
  exact squeeze_zero (fun t => norm_nonneg _) h.decay hg

end Relaxation

